                        bot.isHarvesting = true;
                        bot.harvestChance = triggerCheck;
                        bot.harvestStreak = virtualLs[triggerCheck];
                        bot.harvestCount++;
                        var r = 99.0 / triggerCheck;
                        bot.harvestMultiplier = r / (r - 1);
                        bot.isRecoveryMode = true;
                        bot.recoveryStep = 0;
                        bot.isAfterRecovery = false;
                        
                        var targetBalance = bot.wagerSesiStartBal - bot.wagerLossTolerance;
                        var currentSesiLoss = bot.wagerSesiStartBal - bot.stats.currentBal;
                        var excessLoss = currentSesiLoss - bot.wagerLossTolerance;
                        if (excessLoss < 0) excessLoss = 0;
                        
                        bot.recovery = {
                            active: true,
                            currentSplit: 0,
                            totalSplits: 3,
                            originalSplits: 3,
                            lossPerSplit: excessLoss / 3,
                            lossStreak: 0,
                            startBalance: bot.stats.currentBal,
                            targetBalance: targetBalance,
                            totalLoss: excessLoss,
                            accumulatedLoss: 0,
                            totalLossAccumulated: 0,
                            betLossInSplit: 0,
                            completed: false,
                            splitHistory: [],
                            cutLossCount: 0
                        };
                        
                        var recoveryBet = computeRecoveryBet(bot.stats.currentBal, triggerCheck, {
                            totalLoss: excessLoss,
                            totalSplits: 3,
                            currentSplit: 0,
                            startBalance: bot.stats.currentBal,
                            targetStartBalance: targetBalance,
                            betLossInSplit: 0
                        });
                        
                        if (recoveryBet === null || recoveryBet <= 0) {
                            bot.isRecoveryMode = false;
                            betAmount = computeNormalBet(bot.stats.currentBal);
                            chanceToUse = bot.normalChance;
                            betMode = "normal";
                        } else {
                            bot.harvestBet = recoveryBet;
                            bot.recoveryStep = 0;
                            betAmount = bot.harvestBet;
                            chanceToUse = triggerCheck;
                            betMode = "recovery";
                        }
                        
                        startHarvestTracking(triggerCheck, bot.harvestBet, true);
                        sendTelegramMessage(`🌾 HARVEST TRIGGERED #${bot.harvestCount}\nChance: ${triggerCheck}%\nStreak: ${bot.harvestStreak}\nExcess Loss: ${excessLoss.toFixed(4)}\nTarget: ${targetBalance.toFixed(4)}`);
                        updateWagerDisplay();
                    } else {
                        // NORMAL OR JIT
                        var isBurstBet = false;
                        if (bot.wagerJitEnabled && bot.burstEveryN > 0 && !bot.isHarvesting && !bot.isRecoveryMode && !bot.isBoosterMode) {
                            bot.burstCounter++;
                            if (bot.burstCounter >= bot.burstEveryN) {
                                isBurstBet = true;
                                bot.burstCounter = 0;
                            }
                        }
                        
                        if (isBurstBet) {
                            chanceToUse = getBurstChance();
                            betAmount = getBurstBet(currentBalance);
                            betMode = "jit";
                        } else {
                            chanceToUse = bot.normalChance;
                            betAmount = computeNormalBet(currentBalance);
                            betMode = "normal";
                        }
                        updateBurstDisplay();
                    }
                }
            }
            
            // ===== VALIDASI =====
            if (betAmount > bot.stats.currentBal) betAmount = bot.stats.currentBal;
            if (betAmount < bot.minBet) betAmount = bot.minBet;
            if (bot.maxBetCap > 0 && betAmount > bot.maxBetCap) betAmount = bot.maxBetCap;
            if (betAmount < 0.00000001) betAmount = 0.00000001;
            chanceToUse = Math.min(99.98, Math.max(0.01, chanceToUse));
            
            // ===== HARVEST/RECOVERY HANDLING =====
            if (betMode === "recovery" || betMode === "harvest") {
