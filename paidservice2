                const startTime = performance.now();
                this.callCount++;
                const result = this.dobetFunction();
                this.executionTime = performance.now() - startTime;

                let bet = 0, chance = 49.5;
                if (Array.isArray(result)) {
                    bet = result[0] || 0;
                    chance = result[1] || 49.5;
                } else if (result && typeof result === 'object') {
                    bet = result.bet || result[0] || 0;
                    chance = result.chance || result[1] || 49.5;
                } else if (typeof result === 'number') {
                    bet = result;
