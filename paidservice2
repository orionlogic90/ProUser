        if (el) {
            var time = new Date().toLocaleTimeString();
            el.innerHTML = '<div style="border-bottom:1px solid rgba(255,255,255,0.05);padding:2px 0;">[' + time + '] ' + message + '</div>' + el.innerHTML;
            var entries = el.querySelectorAll('div');
            if (entries.length > 50) entries[entries.length - 1].remove();
        }
    }
    
    function updateLuaStats() {
        var stats = bot.luaEngine.getStats ? bot.luaEngine.getStats() : { callCount: 0, executionTime: 0, scriptLength: 0, isReady: false };
        document.getElementById('lua-calls').textContent = stats.callCount || 0;
        document.getElementById('lua-time').textContent = (stats.executionTime || 0).toFixed(2) + 'ms';
        document.getElementById('lua-size').textContent = (stats.scriptLength || 0) + ' chars';
        document.getElementById('lua-health').textContent = stats.isReady ? '✅ OK' : '❌ ERROR';
        var lines = (bot.luaScript || '').split('\n').length;
        document.getElementById('lua-line-count').textContent = lines || 0;
    }
    
