        loadFengariCDN() {
            return new Promise((resolve, reject) => {
                if (typeof fengari !== 'undefined') {
                    resolve();
                    return;
                }
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/fengari-web@0.1.4/dist/fengari-web.js';
                script.onload = () => {
                    window.fengari = window.fengari || fengari;
                    resolve();
                };
                script.onerror = reject;
                document.head.appendChild(script);
            });
        }

        loadScript(script) {
            if (!this.isReady) {
                this.lastError = 'Lua engine not ready';
                return false;
            }

            try {
                const envVars = Object.keys(this.env).join(',');
                const wrapped = `
                    local env = {${envVars}}
                    for k, v in pairs(env) do _G[k] = v end
                    _ENV = env
                    ${script}
                    return dobet
                `;
                const loaded = fengari.load(wrapped);
                this.dobetFunction = loaded();
                this.luaScript = script;
                this.lastError = null;
                this.callCount = 0;
                console.log('✅ Lua script loaded');
                return true;
            } catch (e) {
                this.lastError = e.message || String(e);
                console.error('❌ Failed to load Lua script:', e);
                return false;
            }
        }

