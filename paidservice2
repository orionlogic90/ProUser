    // ==================== GAME PAYLOADS ====================
    function getDicePayload(amount, chance) {
        var target = 100 / chance;
        return {
            query: `mutation DiceRoll($amount: Float!, $target: Float!, $condition: CasinoGameDiceConditionEnum!, $currency: CurrencyEnum!) {
                diceRoll(amount: $amount, target: $target, condition: $condition, currency: $currency) { payout amount state { result } }
            }`,
            variables: {
                amount: parseFloat(amount.toFixed(8)),
                target: target,
                condition: "above",
                currency: bot.selectedCurrency
            }
        };
    }

    function getLimboPayload(amount, payout) {
        return {
            query: `mutation LimboBet($amount: Float!, $multiplierTarget: Float!, $currency: CurrencyEnum!) {
                limboBet(amount: $amount, multiplierTarget: $multiplierTarget, currency: $currency) { payout amount state { result } }
            }`,
            variables: {
                amount: parseFloat(amount.toFixed(8)),
                multiplierTarget: payout,
                currency: bot.selectedCurrency
            }
        };
    }

    // ==================== PRICE CACHE ====================
    var priceCache = {
        price: 0,
        lastFetch: 0,
        ttl: 3600
    };

    async function getCoinPrice(coin) {
        var now = Date.now() / 1000;
        if (priceCache.price > 0 && (now - priceCache.lastFetch) < priceCache.ttl) {
            return priceCache.price;
        }
        try {
            var coinMap = {
                "doge": "dogecoin",
                "btc": "bitcoin",
                "eth": "ethereum",
                "ltc": "litecoin",
                "sol": "solana",
                "xrp": "ripple",
                "bnb": "binancecoin",
                "ada": "cardano",
                "trx": "tron",
                "usdt": "tether",
                "pol": "polkadot"
            };
            var cgId = coinMap[coin.toLowerCase()] || coin.toLowerCase();
            var res = await fetch(`https://api.coingecko.com/api/v3/simple/price?ids=${cgId}&vs_currencies=usd`, { cache: 'no-cache' });
            var data = await res.json();
            if (data[cgId] && data[cgId].usd) {
                priceCache.price = data[cgId].usd;
                priceCache.lastFetch = now;
                return priceCache.price;
            }
        } catch(e) {}
        return 0;
    }

    // ==================== FIAT RATE ====================
    async function fetchPriceToIDR(coin) {
        var rate = null;
        try {
            var cgId = getCoinGeckoId(coin);
            var cgRes = await fetch(`https://api.coingecko.com/api/v3/simple/price?ids=${cgId}&vs_currencies=idr`, { cache: 'no-cache' });
            var cgData = await cgRes.json();
            if (cgData[cgId] && cgData[cgId].idr) {
                rate = cgData[cgId].idr;
                return rate;
            }
        } catch(e) {}
        try {
            var coinRes = await fetch(`https://api.binance.com/api/v3/ticker/price?symbol=${coin}USDT`, { cache: 'no-cache' });
            var coinData = await coinRes.json();
            var idrRes = await fetch(`https://api.binance.com/api/v3/ticker/price?symbol=USDTIDR`, { cache: 'no-cache' });
            var idrData = await idrRes.json();
            if (coinData.price && idrData.price) {
                rate = parseFloat(coinData.price) * parseFloat(idrData.price);
                return rate;
            }
        } catch(e) {}
        if (coin === "IDR") {
            rate = 1;
            return rate;
        }
        return null;
    }

    function getCoinGeckoId(coin) {
        var map = {
            "DOGE": "dogecoin",
