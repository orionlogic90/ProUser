                chance = Math.max(0.01, Math.min(chance, 99.98));

                this.env.lastBet = bet;
                this.env.lastChance = chance;

                return { bet, chance };
            } catch (e) {
                this.lastError = e.message || String(e);
                console.error('❌ Lua dobet error:', e);
                return null;
            }
        }

        getLastError() { return this.lastError; }
        reset() { this.callCount = 0; this.executionTime = 0; }
