    // ==================== FIRE & FORGET - MODE PROFIT ====================
    function sendProfitBet(amount, game, chance) {
        if (game === "dice") {
            var payload = getDicePayload(amount, chance);
            var meta = {
                type: "profit_dice",
                amount: amount,
                chance: chance,
                game: "dice",
                mode: "profit"
            };
            bot.pendingDiceMeta.push(meta);
            bot.diceInFlight++;
            
            fetch(CONFIG.apiUrl + '/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'x-access-token': accessToken },
                body: JSON.stringify({ query: payload.query, variables: payload.variables })
            }).then(function(response) { return response.json(); })
            .then(function(result) { processProfitResult(result, meta); })
            .catch(function(error) { processProfitResult(null, meta); });
            return meta;
        } else {
            var targetPayout = 99 / chance;
            var payload = getLimboPayload(amount, targetPayout);
            var meta = {
                type: "profit_limbo",
                amount: amount,
                chance: chance,
                payout: targetPayout,
                game: "limbo",
                mode: "profit"
            };
            bot.pendingDiceMeta.push(meta);
            bot.diceInFlight++;
            
            fetch(CONFIG.apiUrl + '/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'x-access-token': accessToken },
                body: JSON.stringify({ query: payload.query, variables: payload.variables })
            }).then(function(response) { return response.json(); })
            .then(function(result) { processProfitResult(result, meta); })
            .catch(function(error) { processProfitResult(null, meta); });
            return meta;
        }
    }

    function processProfitResult(result, meta) {
        bot.diceInFlight = Math.max(0, bot.diceInFlight - 1);
        if (!result || !result.data) {
            logBet(bot.stats.bets + 1, meta.amount.toFixed(4), meta.game, "ERROR", "-");
            return;
        }
        
        var data = result.data;
        var betData = data.diceRoll || data.limboBet;
        if (!betData) {
            logBet(bot.stats.bets + 1, meta.amount.toFixed(4), meta.game, "ERROR", "-");
            return;
        }
        
        var payout = parseFloat(betData.payout) || 0;
        var amount = parseFloat(betData.amount) || meta.amount;
        var pnl = payout - amount;
        var win = pnl > 0;
        
        var resultStr = "?";
        if (betData.state && betData.state.result !== undefined && betData.state.result !== null) {
            resultStr = betData.state.result.toString();
            if (typeof resultStr === "number") resultStr = resultStr.toFixed(2);
        }
        bot.lastResult = resultStr;
        
        // Update balance
        bot.stats.currentBal += pnl;
        if (bot.stats.currentBal < 0) bot.stats.currentBal = 0;
        bot.stats.profit = bot.stats.currentBal - bot.stats.startBal;
        bot.wagerCoin += amount;
        bot.wagerUSD = bot.wagerCoin * bot.coinPrice;
        bot.stats.bets++;
        bot.stats.wagered += amount;
        bot.stats.wins += win ? 1 : 0;
        bot.stats.loss += win ? 0 : 1;
        bot.lastBetAmount = amount;
        bot.lastWinStatus = win;
        bot.betTimestamps.push(Date.now());
        if (bot.betTimestamps.length > 100) bot.betTimestamps.shift();
        
        // === LOGIKA PROFIT MODE ===
        if (bot.onprofit) {
            bot.pfreset += pnl;
            bot.profitc += pnl;
            
            if (win) {
                // WIN → bet turun 40%
                var nextBet = amount * 0.6;
                if (bot.profitc > 0) {
                    // Reset profitc, random game & chance
                    bot.profitc = 0;
                    var randGame = Math.random() > 0.5 ? "dice" : "limbo";
                    bot.currentGame = randGame;
                    bot.currentChance = (Math.floor(Math.random() * (200 - 110 + 1)) + 110) / 10;
                    nextBet = bot.bbprofit;
                    
                    if (bot.isRunning && !bot.isPaused) {
                        sendProfitBet(nextBet, bot.currentGame, bot.currentChance);
                    }
                    updateStatsDisplay();
                    updateWagerDisplay();
                    updateTimer();
                    return;
                }
                if (bot.isRunning && !bot.isPaused) {
                    sendProfitBet(nextBet, bot.currentGame, bot.currentChance);
                }
            } else {
                // LOSS → bet naik
                var streak = Math.abs(bot.stats.loss - 1);
                var payoutMult = 99 / bot.currentChance;
                var nextBet = amount * (1 + (bot.currentChance * 0.02));
                
                if (streak > Math.ceil(payoutMult * 3)) {
                    nextBet = Math.abs(bot.profitc) / (payoutMult - 1) * 1.02;
                }
                if (bot.isRunning && !bot.isPaused) {
                    sendProfitBet(nextBet, bot.currentGame, bot.currentChance);
                }
            }
            
            // CEK SWITCH KE WAGER MODE
            if (bot.pfreset > bot.pfpump) {
                switchToWager();
                updateStatsDisplay();
                updateWagerDisplay();
                updateTimer();
                return;
            }
        }
        
        var profitDisplay = win ? "+" + pnl.toFixed(8) : "-" + amount.toFixed(8);
        logBet(bot.stats.bets, amount.toFixed(4), meta.game, resultStr, profitDisplay);
        
        updateStatsDisplay();
        updateWagerDisplay();
        updateTimer();
        checkStopConditions();
    }

    // ==================== WAGER MODE (SEQUENTIAL) ====================
    async function processWager() {
        if (!bot.isRunning || bot.isPaused || bot.onprofit) return;
        
        var bet = bot.stats.currentBal / bot.dvwager;
        bet = Math.max(bet, bot.minBet);
        if (bot.maxBetCap > 0 && bet > bot.maxBetCap) bet = bot.maxBetCap;
        if (bet > bot.stats.currentBal) bet = bot.stats.currentBal;
        
        var payload = getDicePayload(bet, bot.chwager);
        
        try {
            var response = await fetch(CONFIG.apiUrl + '/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'x-access-token': accessToken },
                body: JSON.stringify({ query: payload.query, variables: payload.variables })
            });
            var result = await response.json();
            
            if (!result || !result.data) {
                setTimeout(processWager, 500);
                return;
            }
            
            var data = result.data;
            var betData = data.diceRoll;
            if (!betData) {
                setTimeout(processWager, 500);
                return;
            }
            
            var payout = parseFloat(betData.payout) || 0;
            var amount = parseFloat(betData.amount) || bet;
            var pnl = payout - amount;
            var win = pnl > 0;
            
            var resultStr = "?";
            if (betData.state && betData.state.result !== undefined && betData.state.result !== null) {
                resultStr = betData.state.result.toString();
                if (typeof resultStr === "number") resultStr = resultStr.toFixed(2);
            }
            bot.lastResult = resultStr;
            
            bot.stats.currentBal += pnl;
            if (bot.stats.currentBal < 0) bot.stats.currentBal = 0;
            bot.stats.profit = bot.stats.currentBal - bot.stats.startBal;
            bot.wagerCoin += amount;
            bot.wagerUSD = bot.wagerCoin * bot.coinPrice;
            bot.stats.bets++;
            bot.stats.wagered += amount;
            bot.stats.wins += win ? 1 : 0;
            bot.stats.loss += win ? 0 : 1;
            bot.lastBetAmount = amount;
            bot.lastWinStatus = win;
            bot.betTimestamps.push(Date.now());
            if (bot.betTimestamps.length > 100) bot.betTimestamps.shift();
            
            // UPDATE WAGER MODE STATE
            bot.pfreset += pnl;
            
            // CEK SWITCH KE PROFIT MODE
            if (bot.pfreset < -bot.pfdump) {
                switchToProfit();
                updateStatsDisplay();
                updateWagerDisplay();
                updateTimer();
                return;
            }
            
            var profitDisplay = win ? "+" + pnl.toFixed(8) : "-" + amount.toFixed(8);
            logBet(bot.stats.bets, amount.toFixed(4), "dice", resultStr, profitDisplay);
            
            updateStatsDisplay();
            updateWagerDisplay();
            updateTimer();
            
            if (checkStopConditions()) return;
            
            // Lanjut wager
            setTimeout(processWager, 10);
            
        } catch(e) {
            setTimeout(processWager, 500);
        }
    }

    // ==================== SWITCH FUNCTIONS ====================
    function switchToWager() {
        bot.onprofit = false;
        bot.pfreset = 0;
        bot.currentGame = "dice";
        bot.currentChance = bot.chwager;
        bot.profitc = 0;
        sendTelegramMessage("🔄 SWITCH TO WAGER MODE | Chance: " + bot.chwager + "% | Bet: balance/" + bot.dvwager, false);
        updateGameStatus();
        // Mulai wager mode (sequential)
        setTimeout(processWager, 100);
    }

    function switchToProfit() {
        bot.onprofit = true;
        bot.pfreset = 0;
        bot.currentGame = "limbo";
        bot.currentChance = bot.chprofit;
        bot.profitc = 0;
        sendTelegramMessage("🔄 SWITCH TO PROFIT MODE | Chance: " + bot.chprofit + "% | Bet: " + bot.bbprofit.toFixed(8), false);
        updateGameStatus();
        // Mulai profit mode (fire & forget)
        if (bot.isRunning && !bot.isPaused) {
            sendProfitBet(bot.bbprofit, "limbo", bot.chprofit);
        }
    }

    // ==================== CHECK STOP CONDITIONS ====================
    function checkStopConditions() {
        // STOP jika balance > balstop (10.1% profit)
        if (bot.stats.currentBal > bot.balstop) {
            bot.isRunning = false;
            sendTelegramMessage("🎯 TARGET REACHED! Balance: " + bot.stats.currentBal.toFixed(4), true);
            toggleStartStop(false);
            return true;
        }
        
        // STOP jika wager target tercapai
        if (bot.wagerUSD >= bot.targetWagerUSD) {
            bot.isRunning = false;
            sendTelegramMessage("🎯 WAGER TARGET REACHED! " + bot.wagerUSD.toFixed(2) + " USD", true);
            toggleStartStop(false);
            return true;
        }
        
        // STOP jika stop loss
        var lossPct = ((bot.sessionStartBalance - bot.stats.currentBal) / bot.sessionStartBalance) * 100;
        if (lossPct >= bot.stopLossPct) {
            bot.isRunning = false;
            sendTelegramMessage("🛑 STOP LOSS REACHED! Loss: " + lossPct.toFixed(2) + "%", true);
            toggleStartStop(false);
            return true;
        }
        
        return false;
    }

    // ==================== UPDATE FUNCTIONS ====================
    function updateGameStatus() {
        var statusEl = document.getElementById("botStatus");
        if (!statusEl) return;
        if (bot.onprofit) {
            statusEl.textContent = "🟢 PROFIT MODE | " + bot.currentGame.toUpperCase() + " " + bot.currentChance + "%";
        } else {
            statusEl.textContent = "🔴 WAGER MODE | DICE " + bot.chwager + "%";
        }
    }

    function updateTimer() {
        var el = document.getElementById("st-running-time");
        if (!el) return;
        if (!bot.startTime) {
            el.textContent = "0s";
            return;
        }
        var seconds = Math.floor((Date.now() - bot.startTime) / 1000);
        var hours = Math.floor(seconds / 3600);
        var minutes = Math.floor((seconds % 3600) / 60);
        var secs = seconds % 60;
        if (hours > 0) el.textContent = hours + "h " + minutes + "m " + secs + "s";
        else if (minutes > 0) el.textContent = minutes + "m " + secs + "s";
        else el.textContent = secs + "s";
    }

    // ==================== UI FUNCTIONS ====================
    function toggleStartStop(starting) {
        var startBtn = document.getElementById("p-start");
        var stopBtn = document.getElementById("p-stop");
        var pauseBtn = document.getElementById("p-pause");
        var statusEl = document.getElementById("botStatus");
        var dotEl = document.getElementById("statusDot");
        if (starting) {
            if (startBtn) startBtn.disabled = true;
            if (stopBtn) stopBtn.disabled = false;
            if (pauseBtn) pauseBtn.disabled = false;
            if (statusEl) statusEl.textContent = "RUN";
            if (dotEl) dotEl.style.background = "#00A86B";
        } else {
            if (startBtn) startBtn.disabled = false;
            if (stopBtn) stopBtn.disabled = true;
            if (pauseBtn) pauseBtn.disabled = true;
            if (statusEl) statusEl.textContent = "STOP";
            if (dotEl) dotEl.style.background = "#FF4757";
        }
    }

    function togglePauseButton(paused) {
        var pauseBtn = document.getElementById("p-pause");
        var startBtn = document.getElementById("p-start");
        if (paused) {
            if (pauseBtn) { pauseBtn.textContent = "PAUSED"; pauseBtn.style.background = "#ff922b"; }
            if (startBtn) { startBtn.disabled = false; startBtn.textContent = "RESUME"; }
        } else {
            if (pauseBtn) { pauseBtn.textContent = "PAUSE"; pauseBtn.style.background = ""; }
            if (startBtn) { startBtn.disabled = true; startBtn.textContent = "START"; }
        }
    }

