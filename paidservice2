                        bot.stats.currentBal,
                        bot.stats.profit,
                        bot.stats.wagered,
                        bot.stats.bets,
                        bot.lastWinStatus
                    );
                    
                    if (luaResult && luaResult.bet > 0) {
                        betAmount = luaResult.bet;
                        chanceToUse = luaResult.chance;
                        betMode = "lua";
