        DOM_CACHE.lastScan = Date.now();
        
        var allEls = document.querySelectorAll('*');
        for (var i = 0; i < Math.min(allEls.length, 100); i++) {
            var text = allEls[i].textContent?.trim() || '';
            if (text === 'Rain Pool' || text.includes('Rain Pool')) {
