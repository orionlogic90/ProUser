    document.getElementById('dicey-generate-bat').addEventListener('click', generateBat);

    var minimized = false;
    var minimizeBtn = $('dicey-minimize');
    var closeBtn = $('dicey-close');

    if (minimizeBtn) {
        minimizeBtn.addEventListener('click', function() {
            minimized = !minimized;
            var content = $('dicey-content');
            if (content) content.style.display = minimized ? 'none' : 'block';
            this.textContent = minimized ? '▼' : '▲';
            container.style.height = minimized ? '44px' : 'auto';
        });
    }

    if (closeBtn) {
        closeBtn.addEventListener('click', function() {
            if (wagerState.isRunning) stopWagerBot();
            if (rainIsRunning) stopRain();
            if (bonusState.isRunning) stopBonusAuto();
            container.style.display = 'none';
        });
    }

    document.addEventListener('keydown', function(e) {
        if (e.ctrlKey && e.shiftKey && e.key === 'D') {
            e.preventDefault();
            container.style.display = container.style.display === 'none' ? 'block' : 'none';
        }
        if (e.key === 'Enter' && e.ctrlKey) {
            e.preventDefault();
            toggleMaster();
        }
        if (e.key === ' ' && e.ctrlKey) {
            e.preventDefault();
            pauseWagerBot();
        }
    });

    // ============================================================
