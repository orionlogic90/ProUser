            isWhitelisted = false;
            updateButtons();
            return;
        }

        checkWhitelist(username).then(function(check) {
            if (check.valid) {
                statusEl.textContent = '✅ ' + check.username + ' - ' + check.remaining;
                statusEl.style.color = '#4ade80';
                if (wagerStatusEl) { wagerStatusEl.textContent = '✅ Unlocked'; wagerStatusEl.style.color = '#4ade80'; }
                if (rainStatusEl) { rainStatusEl.textContent = '✅ Unlocked'; rainStatusEl.style.color = '#4ade80'; }
                if (bonusStatusEl) { bonusStatusEl.textContent = '✅ Unlocked'; bonusStatusEl.style.color = '#4ade80'; }
