function checkUser(username) {
    if (!username || username.trim() === '') {
        return { valid: false, reason: 'Enter username' };
    }
    // SEMUA USER VALID UNTUK TESTING
    return { valid: true, username: username.trim(), remaining: '∞' };
}

function updateStatus() {
    var user = $('dicey-user');
    var status = $('dicey-status');
    var username = user ? user.value.trim() : '';
    
    if (!username) {
        status.textContent = '⏳ Enter username';
        status.style.color = '#888';
        state.isWhitelisted = false;
        updateLocks();
        return;
    }
    
    var result = checkUser(username);
    if (result.valid) {
        status.textContent = '✅ ' + result.username + ' - ' + result.remaining;
        status.style.color = '#4ade80';
        state.isWhitelisted = true;
        state.username = result.username;
        localStorage.setItem('dicey_user', username);
    } else {
        status.textContent = '❌ ' + result.reason;
        status.style.color = '#f87171';
        state.isWhitelisted = false;
    }
    updateLocks();
}

function updateLocks() {
    var locked = !state.isWhitelisted;
    var locks = ['rain-lock', 'wager-lock', 'bonus-lock'];
    var btns = ['rain-btn', 'wager-btn', 'bonus-btn', 'bonus-claim', 'dicey-master'];
    
    locks.forEach(function(id) {
        var el = $(id);
        if (el) {
            el.textContent = locked ? '🔒 Locked' : '✅ Unlocked';
            el.style.color = locked ? '#ff6b81' : '#4ade80';
        }
    });
    
    btns.forEach(function(id) {
        var el = $(id);
        if (el) {
            el.style.opacity = locked ? '0.3' : '1';
            el.style.cursor = locked ? 'not-allowed' : 'pointer';
        }
    });
}

