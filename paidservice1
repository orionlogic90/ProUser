    var ok = $('rain-ok');
    var fail = $('rain-fail');
    var dot = $('rain-dot');
    var btn = $('rain-btn');
    if (ok) ok.textContent = state.rainSuccess;
    if (fail) fail.textContent = state.rainFail;
    if (dot) dot.style.background = state.rainRunning ? '#4ade80' : '#888';
    if (btn) {
        btn.textContent = state.rainRunning ? '■ STOP' : '▶ START';
        btn.style.background = state.rainRunning ? '#ff4757' : '#ff922b';
        btn.style.color = state.rainRunning ? '#fff' : '#000';
    }
}

function toggleRain() {
    if (!state.isWhitelisted) { log('⚠️ Whitelist required!', '#f87171'); return; }
    if (state.rainRunning) {
        state.rainRunning = false;
        if (state.rainInterval) { clearInterval(state.rainInterval); state.rainInterval = null; }
        log('⏹️ Rain stopped', '#f87171');
    } else {
        state.rainRunning = true;
        state.rainSuccess = 0;
        state.rainFail = 0;
        log('▶️ Rain started', '#4ade80');
        if (state.rainInterval) { clearInterval(state.rainInterval); }
        state.rainInterval = setInterval(scanRain, 15000);
        setTimeout(scanRain, 1000);
        setTimeout(scanRain, 3000);
    }
    updateRainUI();
}

