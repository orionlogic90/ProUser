async function placeBet(amount, chance) {
    var target = Math.floor((chance / 100) * 10000);
    var query = 'mutation PlaceDiceBet($input: DiceBetInput!) { placeDiceBet(input: $input) { roundId betAmount targetNumber rollMode rolledNumber multiplier winAmount isWin profit } }';
    var vars = {
        input: {
            betAmount: String(amount),
            cryptoCurrency: 'USDC',
            nonce: genUUID(),
            rollMode: 'Under',
            targetNumber: target
        }
    };
    try {
        var res = await fetch('https://api.dicey.com/graphql', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json', 
                'Origin': 'https://dicey.com',
                'Accept': 'application/json'
            },
            credentials: 'include',
            body: JSON.stringify({ operationName: 'PlaceDiceBet', query: query, variables: vars })
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        var data = await res.json();
        if (data.errors) throw new Error(data.errors[0].message);
        return { success: true, data: data.data.placeDiceBet };
    } catch(e) {
        return { success: false, error: e.message };
    }
}

var wagerLoopRunning = false;

async function doWager() {
    if (!state.wagerRunning || state.wagerPaused || wagerLoopRunning) return;
    wagerLoopRunning = true;
    
    try {
        // Update balance real
        var bal = getRealBalance();
        if (bal !== null && bal > 0) {
            state.wagerBalance = bal;
        }
        
        // Jika balance 0 atau null, stop
        if (state.wagerBalance <= 0) {
            log('❌ Insufficient balance!', '#f87171');
            stopWager();
            wagerLoopRunning = false;
            return;
        }
        
        var l1Bet = 0.01;
        var l1Chance = 98;
        var l2Bet = 0.01;
        
        if (state.wagerTotalBets === 0) {
            state.wagerStartBalance = state.wagerBalance;
        }
        
        state.wagerTotalBets++;
        var amount = state.wagerLayer === 1 ? l1Bet : l2Bet;
        var chance = state.wagerLayer === 1 ? l1Chance : Math.floor(Math.random() * 25) + 50;
        
        // Cek balance cukup
        if (amount > state.wagerBalance) {
            log('❌ Insufficient balance for bet ' + amount.toFixed(4), '#f87171');
            stopWager();
            wagerLoopRunning = false;
            return;
        }
        
        var result = await placeBet(amount, chance);
        if (!result.success) {
            log('❌ Bet failed: ' + result.error, '#f87171');
            wagerLoopRunning = false;
            if (state.wagerRunning) setTimeout(doWager, 5000);
            return;
        }
        
        var d = result.data;
        var profit = parseFloat(d.profit) || 0;
        state.wagerBalance += profit;
        
        if (d.isWin) {
            state.wagerWins++;
            if (state.wagerLayer === 2) {
                state.wagerLayer = 1;
                log('⬆️ Back to L1', '#00e5c0');
            }
        } else {
            state.wagerLosses++;
            if (state.wagerLayer === 1) {
                state.wagerLayer = 2;
                log('⬇️ Switch to L2', '#ff922b');
            } else {
                // Loss di L2 - naikkan bet
                // state.wagerBet *= 1.1;
            }
        }
        
        log('#' + state.wagerTotalBets + ' | ' + amount.toFixed(4) + ' USDC | ' + chance + '% | ' + (d.isWin ? '✅ WIN' : '❌ LOSS'), d.isWin ? '#4ade80' : '#f87171');
        updateWagerUI();
        
        // Target stop
        if (state.wagerTotalBets >= 100) {
            log('🎯 Target 100 bets reached!', '#00e5c0');
            stopWager();
            wagerLoopRunning = false;
            return;
        }
        
        // Stop loss 90%
        var stopLoss = state.wagerStartBalance * 0.1;
        if (state.wagerBalance <= stopLoss) {
            log('🛑 STOP LOSS reached!', '#ff6b6b');
            stopWager();
            wagerLoopRunning = false;
            return;
        }
        
    } catch(e) {
        log('⚠️ ' + e.message, '#f87171');
    }
    
    wagerLoopRunning = false;
    if (state.wagerRunning && !state.wagerPaused) {
        setTimeout(doWager, 1500);
    }
}

function updateWagerUI() {
    var bal = $('w-bal');
    var profit = $('w-profit');
    var bets = $('w-bets');
    var layer = $('w-layer');
    var status = $('w-status');
    var wins = $('w-wins');
    
    var p = state.wagerBalance - state.wagerStartBalance;
    
    if (bal) bal.textContent = state.wagerBalance.toFixed(2);
    if (profit) {
        profit.textContent = (p >= 0 ? '+' : '') + p.toFixed(2);
        profit.style.color = p >= 0 ? '#4ade80' : '#f87171';
    }
    if (bets) bets.textContent = state.wagerTotalBets;
    if (wins) wins.textContent = state.wagerWins;
    if (layer) {
        layer.textContent = state.wagerLayer;
        layer.style.color = state.wagerLayer === 1 ? '#00e5c0' : '#ff922b';
    }
    if (status) {
        if (state.wagerRunning) {
            status.textContent = state.wagerPaused ? '⏸ PAUSED' : '▶ RUNNING';
            status.style.color = state.wagerPaused ? '#ff922b' : '#4ade80';
        } else {
            status.textContent = '⏹ STOP';
            status.style.color = '#ff4757';
        }
    }
}

function toggleWager() {
    if (!state.isWhitelisted) { log('⚠️ Whitelist required!', '#f87171'); return; }
    if (state.wagerRunning && !state.wagerPaused) {
        stopWager();
    } else if (state.wagerRunning && state.wagerPaused) {
        state.wagerPaused = false;
        log('▶️ Resumed', '#00e5c0');
        updateWagerUI();
        setTimeout(doWager, 500);
    } else {
        startWager();
    }
}

function startWager() {
    var bal = getRealBalance();
    if (bal === null || bal <= 0) {
        log('❌ Cannot get balance!', '#f87171');
        return;
    }
    
    state.wagerRunning = true;
    state.wagerPaused = false;
    state.wagerTotalBets = 0;
    state.wagerWins = 0;
    state.wagerLosses = 0;
    state.wagerBalance = bal;
    state.wagerStartBalance = bal;
    state.wagerLayer = 1;
    
    log('▶️ WAGER STARTED | Balance: ' + bal.toFixed(2) + ' USDC', '#00e5c0');
    updateWagerUI();
    setTimeout(doWager, 500);
}

function stopWager() {
    state.wagerRunning = false;
    state.wagerPaused = false;
    wagerLoopRunning = false;
    log('⏹️ WAGER STOPPED', '#f87171');
    updateWagerUI();
}

function pauseWager() {
    if (!state.wagerRunning) { log('⚠️ Not running', '#ffd700'); return; }
    state.wagerPaused = !state.wagerPaused;
    log(state.wagerPaused ? '⏸ Paused' : '▶️ Resumed', '#ffd700');
    updateWagerUI();
    if (!state.wagerPaused) setTimeout(doWager, 500);
}

function resetWager() {
    stopWager();
    state.wagerTotalBets = 0;
    state.wagerWins = 0;
    state.wagerLosses = 0;
    state.wagerLayer = 1;
    var bal = getRealBalance();
    if (bal !== null && bal > 0) {
        state.wagerBalance = bal;
        state.wagerStartBalance = bal;
    }
    log('🔄 RESET', '#ffd700');
    updateWagerUI();
}

