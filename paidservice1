                } else {
                    rainLog('❌ Chat tab not found!', '#f87171');
                    rainIsProcessing = false;
                    return;
                }
            }

            // STEP 3: Sudah di Chat - cek Add to Rain
            var addBtn = findAddToRainButton();
            if (addBtn) {
                if (rainLastLog !== '✅ In rain pool - waiting...') {
                    rainLog('✅ In rain pool - waiting for next rain...', '#4ade80');
