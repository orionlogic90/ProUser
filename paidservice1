        if (bonusState.isRunning) {
            bonusLog('⚠️ Already running', '#fbbf24');
            return;
        }
        var intervalEl = document.getElementById('dicey-claim-interval');
        var intervalMinutes = intervalEl ? parseInt(intervalEl.value) : 60;
        bonusState.isRunning = true;
        bonusLog('▶️ Auto-claim started (every ' + intervalMinutes + ' min)', '#4ade80');
        updateBonusUI();
        setTimeout(claimAllBonuses, 1000);
        if (bonusState.intervalId) clearInterval(bonusState.intervalId);
        bonusState.intervalId = setInterval(function() {
            if (bonusState.isRunning) {
                claimAllBonuses();
            }
        }, intervalMinutes * 60 * 1000);
        updateMasterUI();
    }

