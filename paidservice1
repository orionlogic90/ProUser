// ============================================================
function getMasterStatus() {
    var r = state.rainRunning;
    var w = state.wagerRunning;
    var b = state.bonusRunning;
    if (!r && !w && !b) return 'stopped';
    if (r && w && b) return 'running';
    return 'partial';
}

function updateMaster() {
    var btn = $('dicey-master');
    var status = getMasterStatus();
    if (!btn) return;
    if (status === 'stopped') {
        btn.textContent = '🚀 START ALL';
        btn.style.background = '#ff6b35';
    } else if (status === 'running') {
        btn.textContent = '■ STOP ALL';
        btn.style.background = '#ff4757';
    } else {
        btn.textContent = '⚠️ RESUME ALL';
        btn.style.background = '#ff922b';
    }
}

function toggleMaster() {
    if (!state.isWhitelisted) { log('⚠️ Whitelist required!', '#f87171'); return; }
    var status = getMasterStatus();
    if (status === 'stopped' || status === 'partial') {
        log('🚀 STARTING ALL...', '#ff6b35');
        // Bonus dulu
        if (!state.bonusRunning) toggleBonus();
        setTimeout(function() {
            // Wager
            if (!state.wagerRunning) toggleWager();
        }, 500);
        setTimeout(function() {
            // Rain terakhir
            if (!state.rainRunning) toggleRain();
            updateMaster();
            log('✅ ALL STARTED!', '#4ade80');
        }, 1000);
    } else {
        log('🛑 STOPPING ALL...', '#ff4757');
        // Rain dulu
        if (state.rainRunning) toggleRain();
        setTimeout(function() {
            if (state.wagerRunning) toggleWager();
        }, 300);
        setTimeout(function() {
            if (state.bonusRunning) toggleBonus();
            updateMaster();
            log('⏹️ ALL STOPPED!', '#ffd700');
        }, 600);
    }
}

