// ============================================================
function getMasterStatus() {
    var r = state.rainRunning;
    var w = state.wagerRunning;
    var b = state.bonusRunning;
    if (!r && !w && !b) return 'stopped';
    if (r && w && b) return 'running';
    return 'partial';
}

function updateMaster() {
    var btn = $('dicey-master');
    var status = getMasterStatus();
    if (!btn) return;
    if (status === 'stopped') {
        btn.textContent = '🚀 START ALL';
        btn.style.background = '#ff6b35';
    } else if (status === 'running') {
        btn.textContent = '■ STOP ALL';
        btn.style.background = '#ff4757';
    } else {
        btn.textContent = '⚠️ RESUME ALL';
        btn.style.background = '#ff922b';
    }
}

function toggleMaster() {
    if (!state.isWhitelisted) { log('⚠️ Whitelist required!', '#f87171'); return; }
    var status = getMasterStatus();
    
    if (status === 'stopped' || status === 'partial') {
        log('🚀 STARTING ALL...', '#ff6b35');
        
        // 1. BONUS dulu
        if (!state.bonusRunning) {
            toggleBonus();
            log('✅ BONUS started', '#4ade80');
        }
        
        // 2. WAGER - TAPI HARUS DIKLIK MANUAL, JADI KITA START
        setTimeout(function() {
            if (!state.wagerRunning) {
                startWager();
                log('✅ WAGER started', '#4ade80');
            }
        }, 500);
        
        // 3. RAIN terakhir
        setTimeout(function() {
            if (!state.rainRunning) {
                toggleRain();
                log('✅ RAIN started', '#4ade80');
            }
            updateMaster();
            log('✅ ALL SYSTEMS RUNNING!', '#00e5c0');
        }, 1000);
        
    } else {
        log('🛑 STOPPING ALL...', '#ff4757');
        
        // 1. RAIN dulu
        if (state.rainRunning) {
            toggleRain();
            log('⏹️ RAIN stopped', '#f87171');
        }
        
        // 2. WAGER
        setTimeout(function() {
            if (state.wagerRunning) {
                stopWager();
                log('⏹️ WAGER stopped', '#f87171');
            }
        }, 300);
        
        // 3. BONUS
        setTimeout(function() {
            if (state.bonusRunning) {
                toggleBonus();
                log('⏹️ BONUS stopped', '#f87171');
            }
            updateMaster();
            log('⏹️ ALL SYSTEMS STOPPED', '#ffd700');
        }, 600);
    }
}

