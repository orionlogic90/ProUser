            } else {
                statusEl.textContent = '❌ ' + check.reason;
                statusEl.style.color = '#f87171';
                if (wagerStatusEl) { wagerStatusEl.textContent = '🔒 Locked'; wagerStatusEl.style.color = '#ff6b81'; }
