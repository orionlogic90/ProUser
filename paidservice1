                    forceClickButton(chatTab);
                    setTimeout(function() {
                        if (rainIsRunning) findAndProcessRainButtons();
                    }, 1500);
                    rainIsProcessing = false;
                    return;
                }
                rainIsProcessing = false;
                return;
            }

            var addToRainBtn = findAddToRainButton();
            if (addToRainBtn) {
                if (rainLastLog !== '✅ In rain pool - waiting for next rain...') {
