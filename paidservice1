    const WHITELIST_URL = 'https://raw.githubusercontent.com/orionlogic90/ProUser/refs/heads/main/whitelist.json';

    let whitelistCache = {
        data: null,
        lastFetch: 0,
        cacheDuration: 300000
    };

    async function fetchWhitelist() {
        try {
            const now = Date.now();
            if (whitelistCache.data && (now - whitelistCache.lastFetch) < whitelistCache.cacheDuration) {
                return whitelistCache.data;
            }
            
            const response = await fetch(WHITELIST_URL, {
                method: 'GET',
                headers: {
                    'Accept': 'application/json',
                    'Cache-Control': 'no-cache'
                }
            });
            
            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }
            
            const data = await response.json();
            if (!data.users || typeof data.users !== 'object') {
                throw new Error('Invalid whitelist format');
            }
            
            whitelistCache.data = data;
            whitelistCache.lastFetch = now;
            return data;
            
        } catch (error) {
            console.error('❌ Failed to fetch whitelist:', error);
            if (whitelistCache.data) {
                return whitelistCache.data;
            }
            return {
                users: {
                    'dengkodice': '2026-12-31',
                    'trial': '2026-07-15'
                }
            };
        }
    }

    async function checkWhitelist(username) {
        const trimmed = username.trim().toLowerCase();
        if (!trimmed) {
            return { valid: false, reason: 'Please enter username' };
        }
        
        try {
            const data = await fetchWhitelist();
            const users = data.users || {};
            
            if (!users.hasOwnProperty(trimmed)) {
                return { valid: false, reason: 'Username not in whitelist' };
            }
            
            const expiry = users[trimmed];
            if (expiry === 'permanent') {
                return { valid: true, username: trimmed, expiry: 'Permanent', remaining: '∞' };
            }
            
            const expiryDate = new Date(expiry);
            if (isNaN(expiryDate.getTime())) {
                return { valid: false, reason: 'Invalid expiry format' };
            }
            
            if (new Date() > expiryDate) {
                return { valid: false, reason: 'License expired (' + expiry + ')' };
            }
            
            const remaining = Math.ceil((expiryDate - new Date()) / (1000 * 60 * 60 * 24));
            return { valid: true, username: trimmed, expiry: expiry, remaining: remaining + ' days' };
            
        } catch (error) {
            console.error('Whitelist check error:', error);
            return { valid: false, reason: 'Cannot verify license' };
        }
