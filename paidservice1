    function getRealBalance() {
        try {
            var selectors = [
                '[class*="balance"]', '[class*="Balance"]',
                '[data-testid="balance"]', '.balance-amount',
                '.user-balance', '.wallet-balance',
                '[class*="wallet"] [class*="amount"]'
            ];
            for (var i = 0; i < selectors.length; i++) {
                var elements = document.querySelectorAll(selectors[i]);
                for (var j = 0; j < elements.length; j++) {
                    var text = elements[j].textContent.trim();
                    var match = text.match(/(\d+\.?\d*)/);
                    if (match) {
                        var num = parseFloat(match[1]);
                        if (num > 0) return num;
                    }
                }
            }
            return null;
        } catch(e) {
            return null;
        }
    }

    function getUsername() {
        try {
            var selectors = ['[class*="user"]', '[class*="User"]', '[class*="profile"]', '.username'];
            for (var i = 0; i < selectors.length; i++) {
                var el = document.querySelector(selectors[i]);
                if (el) {
                    var text = el.textContent.trim();
                    if (text && text.length > 0 && text.length < 30) return text;
                }
            }
            return '-';
        } catch(e) {
            return '-';
        }
    }

    async function placeBet(betAmount, chance) {
        var cryptoCurrency = getCurrency();
        var rollMode = 'Under';
        var targetNumber = Math.floor((chance / 100) * 10000);

        var query = 'mutation PlaceDiceBet($input: DiceBetInput!) { placeDiceBet(input: $input) { roundId activityId betAmount targetNumber targetNumberLower targetNumberUpper rollMode rolledNumber multiplier winAmount isWin profit timestamp __typename } }';

        var variables = {
            input: {
                betAmount: String(betAmount),
                cryptoCurrency: cryptoCurrency,
                nonce: generateUUID(),
                rollMode: rollMode,
                targetNumber: targetNumber
            }
        };

        var payload = {
            operationName: "PlaceDiceBet",
            query: query,
            variables: variables
        };

        try {
            var response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/graphql-response+json, application/graphql+json, application/json',
                    'Origin': 'https://dicey.com'
                },
                credentials: 'include',
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            var data = await response.json();
            if (data.errors) {
                throw new Error(data.errors[0].message);
            }
            return { success: true, data: data.data.placeDiceBet };
        } catch (error) {
            return { success: false, error: error.message };
        }
    }

    async function doBet() {
        if (!wagerState.isRunning || wagerState.isPaused) return null;

        var realBalance = getRealBalance();
        if (realBalance !== null && realBalance > 0) {
            wagerState.currentBalance = realBalance;
        }

        var layer1ChanceEl = $('dicey-layer1-chance');
        var layer1BetEl = $('dicey-layer1-bet');
        var layer1MultiplierEl = $('dicey-layer1-multiplier');
        var layer2ChanceMinEl = $('dicey-layer2-chance-min');
        var layer2ChanceMaxEl = $('dicey-layer2-chance-max');
        var layer2BetEl = $('dicey-layer2-bet');
        var layer2MultiplierEl = $('dicey-layer2-multiplier');
        var backStreakEl = $('dicey-back-streak');
        var backProfitEl = $('dicey-back-profit');
        var resetLossStreakEl = $('dicey-reset-loss-streak');
        var resetWinStreakEl = $('dicey-reset-win-streak');
        var resetProfitEl = $('dicey-reset-profit');
        var resetLossEl = $('dicey-reset-loss');

        var layer1Chance = layer1ChanceEl ? parseFloat(layer1ChanceEl.value) : 98;
        var layer1Bet = layer1BetEl ? parseFloat(layer1BetEl.value) : 0.01;
        var layer1Multiplier = layer1MultiplierEl ? parseFloat(layer1MultiplierEl.value) : 1;
        var layer2ChanceMin = layer2ChanceMinEl ? parseFloat(layer2ChanceMinEl.value) : 50;
        var layer2ChanceMax = layer2ChanceMaxEl ? parseFloat(layer2ChanceMaxEl.value) : 75;
        var layer2Bet = layer2BetEl ? parseFloat(layer2BetEl.value) : 0.01;
        var layer2Multiplier = layer2MultiplierEl ? parseFloat(layer2MultiplierEl.value) : 1.1;
        var backStreak = backStreakEl ? parseInt(backStreakEl.value) : 1;
        var backProfit = backProfitEl ? parseFloat(backProfitEl.value) : 0.01;
        var resetLossStreak = resetLossStreakEl ? parseInt(resetLossStreakEl.value) : 0;
        var resetWinStreak = resetWinStreakEl ? parseInt(resetWinStreakEl.value) : 0;
        var resetProfit = resetProfitEl ? parseFloat(resetProfitEl.value) : 0;
        var resetLoss = resetLossEl ? parseFloat(resetLossEl.value) : 0;

        if (wagerState.totalBets === 0) {
            wagerState.startBalance = wagerState.currentBalance || 3;
            wagerState.layer1OriginalBet = layer1Bet;
            wagerState.layer2OriginalBet = layer2Bet;
            wagerState.currentBet = layer1Bet;
            wagerState.currentLayer = 1;
            wagerState.entryBalance = wagerState.currentBalance;
            wagerState.lossRecovery = 0;
            wagerState.totalLossInL2 = 0;
            wagerState.startTime = Date.now();
            if (wagerState.timerInterval) clearInterval(wagerState.timerInterval);
            wagerState.timerInterval = setInterval(updateWagerTimer, 1000);
        }

        wagerState.totalBets++;

        var betAmount, chance, layerDisplay;
        if (wagerState.currentLayer === 1) {
            betAmount = wagerState.currentBet;
            chance = layer1Chance;
            layerDisplay = 'L1';
            wagerState.layer1Bets++;
        } else {
            betAmount = wagerState.currentBet;
            if (layer2ChanceMin < layer2ChanceMax) {
                chance = Math.floor(Math.random() * (layer2ChanceMax - layer2ChanceMin + 1)) + layer2ChanceMin;
                chance = Math.round(chance * 2) / 2;
            } else {
                chance = layer2ChanceMin;
            }
            chance = Math.max(1, Math.min(98, chance));
            layerDisplay = 'L2 (x' + layer2Multiplier.toFixed(1) + ')';
            wagerState.layer2Bets++;
        }

        var result = await placeBet(betAmount, chance);

        if (!result.success) {
            wagerLog('❌ ' + result.error, '#ff6b6b');
            var maxRetries = 3;
            for (var i = 0; i < maxRetries; i++) {
                await sleep(2000);
                var retryResult = await placeBet(betAmount, chance);
                if (retryResult.success) {
                    result.data = retryResult.data;
                    result.success = true;
                    break;
                }
            }
            if (!result.success) {
                updateWagerUI();
                return null;
            }
        }

        var data = result.data;
        wagerState.wagered += betAmount;

        var profitNum = parseFloat(data.profit) || 0;
        wagerState.currentBalance += profitNum;

        var realBalance2 = getRealBalance();
        if (realBalance2 !== null && realBalance2 > 0) {
            wagerState.currentBalance = realBalance2;
        }

        var resultText = data.isWin ? '✅ WIN' : '❌ LOSS';
        var resultColor = data.isWin ? '#00e5c0' : '#ff6b81';
        var profitText = (data.isWin ? '+' : '') + data.profit;
        wagerLog('#' + wagerState.totalBets + ' | ' + betAmount.toFixed(4) + ' ' + getCurrencyDisplay() + ' | ' + chance + '% | ' + resultText + ' | ' + profitText, resultColor);

        if (data.isWin) {
            wagerState.totalWins++;
            wagerState.currentStreak = wagerState.currentStreak > 0 ? wagerState.currentStreak + 1 : 1;

            if (wagerState.currentLayer === 1) {
                wagerState.layer1Wins++;
                wagerState.currentBet = layer1Bet;
                wagerState.lossRecovery = 0;
                wagerState.totalLossInL2 = 0;
            } else {
                wagerState.layer2Wins++;
                wagerState.lossRecovery += profitNum;

                var shouldReset = false;
                var resetReason = '';

                if (resetWinStreak > 0 && wagerState.currentStreak >= resetWinStreak) {
                    shouldReset = true;
                    resetReason = 'Win streak ' + wagerState.currentStreak;
                }
                if (resetProfit > 0 && wagerState.lossRecovery >= resetProfit) {
                    shouldReset = true;
                    resetReason = 'Profit ' + wagerState.lossRecovery.toFixed(4);
                }
                if (resetLoss > 0 && (wagerState.currentBalance - wagerState.entryBalance) <= -resetLoss) {
                    shouldReset = true;
                    resetReason = 'Loss ' + (wagerState.entryBalance - wagerState.currentBalance).toFixed(4);
                }

                if (shouldReset) {
                    wagerLog('🔄 RESET to L1 (' + resetReason + ')', '#ff922b');
                    wagerState.currentLayer = 1;
                    wagerState.currentBet = layer1Bet;
                    wagerState.currentStreak = 0;
                    wagerState.entryBalance = wagerState.currentBalance;
                    wagerState.lossRecovery = 0;
                    wagerState.totalLossInL2 = 0;
                } else if (backProfit > 0 && wagerState.lossRecovery >= backProfit) {
                    wagerState.currentLayer = 1;
                    wagerState.currentBet = layer1Bet;
                    wagerState.currentStreak = 0;
                    wagerState.entryBalance = wagerState.currentBalance;
                    wagerState.lossRecovery = 0;
                    wagerState.totalLossInL2 = 0;
                } else if (wagerState.currentStreak >= backStreak) {
                    wagerState.currentLayer = 1;
                    wagerState.currentBet = layer1Bet;
                    wagerState.currentStreak = 0;
                    wagerState.entryBalance = wagerState.currentBalance;
                    wagerState.lossRecovery = 0;
                    wagerState.totalLossInL2 = 0;
                } else {
                    wagerState.currentBet = wagerState.currentBet * layer2Multiplier;
                    if (wagerState.currentBet > wagerState.currentBalance * 0.5) {
                        wagerState.currentBet = wagerState.currentBalance * 0.5;
                    }
                }
            }
        } else {
            wagerState.totalLosses++;
            wagerState.currentStreak = wagerState.currentStreak < 0 ? wagerState.currentStreak - 1 : -1;

            if (wagerState.currentLayer === 1) {
                var newBet = wagerState.currentBet * layer1Multiplier;
                wagerState.currentBet = Math.max(newBet, layer2Bet);
                wagerState.currentLayer = 2;
                wagerState.entryBalance = wagerState.currentBalance;
                wagerState.lossRecovery = 0;
                wagerState.totalLossInL2 = 0;
                wagerLog('⬆️ SWITCH to L2 (bet: ' + wagerState.currentBet.toFixed(4) + ')', '#ff922b');
            } else {
                wagerState.totalLossInL2 += Math.abs(profitNum);

                var shouldResetLoss = false;
                var resetLossReason = '';

                if (resetLossStreak > 0 && Math.abs(wagerState.currentStreak) >= resetLossStreak) {
                    shouldResetLoss = true;
                    resetLossReason = 'Loss streak ' + Math.abs(wagerState.currentStreak);
                }
                if (resetLoss > 0 && (wagerState.entryBalance - wagerState.currentBalance) >= resetLoss) {
                    shouldResetLoss = true;
                    resetLossReason = 'Loss ' + (wagerState.entryBalance - wagerState.currentBalance).toFixed(4);
                }

                if (shouldResetLoss) {
                    wagerLog('🔄 RESET to L1 (' + resetLossReason + ')', '#ff922b');
                    wagerState.currentLayer = 1;
                    wagerState.currentBet = layer1Bet;
                    wagerState.currentStreak = 0;
                    wagerState.entryBalance = wagerState.currentBalance;
                    wagerState.lossRecovery = 0;
                    wagerState.totalLossInL2 = 0;
                } else {
                    wagerState.currentBet = wagerState.currentBet * layer2Multiplier;
                    if (wagerState.currentBet > wagerState.currentBalance * 0.5) {
                        wagerState.currentBet = wagerState.currentBalance * 0.5;
                    }
                }

                if (wagerState.currentStreak <= -10) {
                    wagerState.currentLayer = 1;
                    wagerState.currentBet = layer1Bet;
                    wagerState.currentStreak = 0;
                    wagerState.entryBalance = wagerState.currentBalance;
                    wagerState.lossRecovery = 0;
                    wagerState.totalLossInL2 = 0;
                    wagerLog('🆘 Emergency reset to L1', '#ff6b6b');
                }
            }
        }

        var targetProfitPercentEl = $('dicey-target-profit');
        var stopLossPercentEl = $('dicey-stop-loss');
        var stopOnWinEl = $('dicey-stop-on-win');

        var targetProfitPercent = targetProfitPercentEl ? parseFloat(targetProfitPercentEl.value) : 100;
        var stopLossPercent = stopLossPercentEl ? parseFloat(stopLossPercentEl.value) : 90;
        wagerState.stopLossPercent = stopLossPercent;

        var targetProfit = wagerState.startBalance * (targetProfitPercent / 100);
        var stopLoss = wagerState.startBalance * (1 - stopLossPercent / 100);

        var wagerTargetEl = $('dicey-wager-target-input');
        var wagerTarget = wagerTargetEl ? parseFloat(wagerTargetEl.value) : 300;
        if (wagerState.wagered >= wagerTarget) {
            var profit = wagerState.currentBalance - wagerState.startBalance;
            wagerLog('🎯 TARGET ' + wagerTarget + ' USDC REACHED! 📊 ' + (profit >= 0 ? '+' : '') + profit.toFixed(4) + ' USDC', '#00e5c0');
            wagerLog('📊 Bets: ' + wagerState.totalBets + ' | Wager: ' + wagerState.wagered.toFixed(2) + ' USDC', '#ffd700');
            stopWagerBot();
            return null;
        }

        if (wagerState.currentBalance - wagerState.startBalance >= targetProfit) {
            wagerLog('🎯 Target +' + targetProfitPercent + '% reached!', '#00e5c0');
            stopWagerBot();
            return null;
        }

        if (wagerState.currentBalance <= stopLoss) {
            wagerLog('🛑 STOP LOSS -' + stopLossPercent + '%', '#ff6b6b');
            wagerLog('📊 Wager: ' + wagerState.wagered.toFixed(2) + ' USDC | Bets: ' + wagerState.totalBets, '#ffd700');
            stopWagerBot();
            return null;
        }

        if (stopOnWinEl && stopOnWinEl.checked && wagerState.currentStreak >= 5) {
            wagerLog('🛑 Win streak: ' + wagerState.currentStreak, '#ffd700');
            stopWagerBot();
            return null;
        }

        updateWagerUI();
        return data;
    }

    function wagerLoop() {
        if (!wagerState.isRunning || wagerState.isPaused || wagerState.isLooping) return;
        wagerState.isLooping = true;

        doBet().then(function() {
            wagerState.isLooping = false;
            var autoContinueEl = $('dicey-auto-continue');
            if (wagerState.isRunning && !wagerState.isPaused && autoContinueEl && autoContinueEl.checked) {
                var cooldownEl = $('dicey-cooldown');
                var cooldown = cooldownEl ? parseInt(cooldownEl.value) : 1500;
                setTimeout(wagerLoop, cooldown);
            }
        }).catch(function(e) {
            wagerState.isLooping = false;
            wagerLog('⚠️ Error: ' + e.message, '#ff6b6b');
            setTimeout(wagerLoop, 5000);
        });
    }

    function startWagerBot() {
        if (!isWhitelisted) {
            wagerLog('⚠️ Whitelist required!', '#f87171');
            return;
        }
        if (wagerState.isRunning && !wagerState.isPaused) {
            wagerLog('⚠️ Already running', '#ffd700');
            return;
        }
        if (wagerState.isPaused) {
            wagerState.isPaused = false;
            wagerState.isRunning = true;
            wagerLog('▶️ Resumed', '#00e5c0');
            updateWagerUI();
            setTimeout(wagerLoop, 500);
            updateMasterUI();
            return;
        }

        var layer1BetEl = $('dicey-layer1-bet');
        var layer1Bet = layer1BetEl ? parseFloat(layer1BetEl.value) : 0.01;
        if (layer1Bet <= 0) {
            wagerLog('⚠️ Set valid Layer 1 bet', '#ff6b6b');
            return;
        }

        wagerState.username = getUsername();
        wagerState.isRunning = true;
        wagerState.isPaused = false;
        wagerState.totalBets = 0;
        wagerState.totalWins = 0;
        wagerState.totalLosses = 0;
        wagerState.currentStreak = 0;
        wagerState.currentLayer = 1;
        wagerState.currentBet = layer1Bet;
        wagerState.wagered = 0;
        wagerState.layer1Bets = 0;
        wagerState.layer2Bets = 0;
        wagerState.layer1Wins = 0;
        wagerState.layer2Wins = 0;
        wagerState.layer1OriginalBet = layer1Bet;
        var layer2BetEl = $('dicey-layer2-bet');
        wagerState.layer2OriginalBet = layer2BetEl ? parseFloat(layer2BetEl.value) : 0.01;
        wagerState.lossRecovery = 0;
        wagerState.totalLossInL2 = 0;
        wagerState.isLooping = false;

        var realBalance = getRealBalance();
        if (realBalance !== null && realBalance > 0) {
            wagerState.currentBalance = realBalance;
            wagerState.startBalance = realBalance;
            wagerLog('💰 Balance: ' + realBalance.toFixed(4) + ' ' + getCurrencyDisplay(), '#00e5c0');
        } else {
            wagerState.currentBalance = 3;
            wagerState.startBalance = 3;
            wagerLog('⚠️ Using estimated balance (3 USDC)', '#ffd700');
        }
        wagerState.entryBalance = wagerState.currentBalance;

        var wagerTargetEl = $('dicey-wager-target-input');
        var wagerTarget = wagerTargetEl ? parseFloat(wagerTargetEl.value) : 300;
        wagerState.targetWager = wagerTarget;

        wagerState.startTime = Date.now();
        if (wagerState.timerInterval) clearInterval(wagerState.timerInterval);
        wagerState.timerInterval = setInterval(updateWagerTimer, 1000);

        wagerLog('▶️ STARTED | Target: ' + wagerTarget + ' USDC', '#00e5c0');
        updateWagerUI();
        setTimeout(wagerLoop, 500);
        updateMasterUI();
    }

    function pauseWagerBot() {
        if (!wagerState.isRunning) {
            wagerLog('⚠️ Bot not running', '#ffd700');
            return;
        }
        wagerState.isPaused = !wagerState.isPaused;
        wagerLog(wagerState.isPaused ? '⏸ Paused' : '▶️ Resumed', '#ffd700');
        updateWagerUI();
        if (!wagerState.isPaused) {
            setTimeout(wagerLoop, 500);
        }
        updateMasterUI();
    }

    function stopWagerBot() {
        wagerState.isRunning = false;
        wagerState.isPaused = false;
        wagerState.isLooping = false;
        if (wagerState.timerInterval) {
            clearInterval(wagerState.timerInterval);
            wagerState.timerInterval = null;
        }
        var profit = wagerState.currentBalance - wagerState.startBalance;
        wagerLog('⏹ STOPPED | ' + (profit >= 0 ? '+' : '') + profit.toFixed(4) + ' ' + getCurrencyDisplay(), '#ffd700');
        wagerLog('📊 Wager: ' + wagerState.wagered.toFixed(2) + ' USDC | Bets: ' + wagerState.totalBets, '#a0a0a0');
        updateWagerUI();
        updateMasterUI();
    }

    function resetWagerBot() {
        stopWagerBot();
        wagerState.totalBets = 0;
        wagerState.totalWins = 0;
        wagerState.totalLosses = 0;
        wagerState.currentStreak = 0;
        wagerState.wagered = 0;
        wagerState.layer1Bets = 0;
        wagerState.layer2Bets = 0;
        wagerState.layer1Wins = 0;
        wagerState.layer2Wins = 0;
        wagerState.lossRecovery = 0;
        wagerState.totalLossInL2 = 0;

        var realBalance = getRealBalance();
        if (realBalance !== null && realBalance > 0) {
            wagerState.currentBalance = realBalance;
            wagerState.startBalance = realBalance;
        }

        wagerLog('🔄 RESET', '#ffd700');
        updateWagerUI();
        updateMasterUI();
    }

    // ============================================================
    // PROXY FUNCTIONS
    // ============================================================
    function saveProxies() {
        var inputs = document.querySelectorAll('#tab-proxy input[type="text"]');
        var proxies = [];
        inputs.forEach(function(input) {
            if (input.value.trim()) {
                proxies.push(input.value.trim());
            }
        });
        if (proxies.length === 0) {
            document.getElementById('dicey-proxy-status').textContent = '⚠️ No proxy entered';
            document.getElementById('dicey-proxy-status').style.color = '#f87171';
            return;
        }
        try {
            localStorage.setItem('dicey_proxies', JSON.stringify(proxies));
            document.getElementById('dicey-proxy-status').textContent = '✅ ' + proxies.length + ' proxies saved!';
            document.getElementById('dicey-proxy-status').style.color = '#4ade80';
            log('🌐 ' + proxies.length + ' proxies saved', '#9ec07c');
        } catch(e) {
            document.getElementById('dicey-proxy-status').textContent = '❌ Failed to save';
            document.getElementById('dicey-proxy-status').style.color = '#f87171';
        }
    }

    function generateBat() {
        var proxiesStr = localStorage.getItem('dicey_proxies');
        if (!proxiesStr) {
            alert('⚠️ No proxy saved! Enter proxies first.');
            return;
        }
        var proxies = JSON.parse(proxiesStr);
        if (proxies.length === 0) {
            alert('⚠️ No proxy saved!');
            return;
        }

        var batContent = '@echo off\n';
        batContent += 'echo Starting DiceY Bots with Proxies...\n';
        batContent += 'echo.\n';

        proxies.forEach(function(proxy, i) {
            var profileNum = i + 1;
            var profileDir = 'C:\\ChromeProfiles\\DiceY-' + profileNum;
            batContent += 'start "" "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" --user-data-dir="' + profileDir + '" --proxy-server="' + proxy + '" "https://dicey.com/casino"\n';
        });

        batContent += '\necho All ' + proxies.length + ' bots started!\n';
        batContent += 'pause';

        var blob = new Blob([batContent], { type: 'text/plain' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'start-bots.bat';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        log('📥 ' + proxies.length + ' proxy .bat generated', '#ff922b');
    }

    function loadSavedProxies() {
        try {
            var proxiesStr = localStorage.getItem('dicey_proxies');
            if (proxiesStr) {
                var proxies = JSON.parse(proxiesStr);
                var inputs = document.querySelectorAll('#tab-proxy input[type="text"]');
                inputs.forEach(function(input, index) {
                    if (index < proxies.length) {
                        input.value = proxies[index];
                    }
                });
                document.getElementById('dicey-proxy-status').textContent = '✅ ' + proxies.length + ' proxies loaded';
                document.getElementById('dicey-proxy-status').style.color = '#4ade80';
            }
        } catch(e) {}
    }

