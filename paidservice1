function findJoin() {
    var all = document.querySelectorAll('button, [role="button"]');
    for (var i = 0; i < all.length; i++) {
        if (all[i].textContent.trim() === 'Join') {
            var r = all[i].getBoundingClientRect();
            if (r.width > 0 && r.height > 0) return all[i];
        }
    }
    return null;
}

function findAddRain() {
    var all = document.querySelectorAll('button, [role="button"]');
    for (var i = 0; i < all.length; i++) {
        var t = all[i].textContent.trim();
        if (t === 'Add to Rain' || t.includes('Add to Rain')) {
            var r = all[i].getBoundingClientRect();
            if (r.width > 0 && r.height > 0) return all[i];
        }
    }
    return null;
}

function clickBtn(btn) {
    if (!btn) return false;
    try {
        btn.click();
        btn.dispatchEvent(new MouseEvent('click', {bubbles:true}));
        btn.dispatchEvent(new PointerEvent('pointerdown', {bubbles:true}));
        btn.dispatchEvent(new PointerEvent('pointerup', {bubbles:true}));
        return true;
    } catch(e) { return false; }
}

var rainLogLast = '';
var rainLogTime = 0;

function rlog(msg, color) {
    color = color || '#888';
    var el = $('rain-log');
    if (!el) return;
    var now = Date.now();
    if (msg === rainLogLast && now - rainLogTime < 2000) return;
    rainLogLast = msg;
    rainLogTime = now;
    var t = new Date().toLocaleTimeString();
    el.innerHTML += '<div style="color:' + color + ';padding:1px 0;font-size:7px;">[' + t + '] ' + msg + '</div>';
    el.scrollTop = el.scrollHeight;
    if (el.children.length > 30) el.removeChild(el.firstChild);
}

function scanRain() {
    if (!state.rainRunning) return;
    
    try {
        var add = findAddRain();
        if (add) {
            if (rainLogLast !== '✅ In rain pool') rlog('✅ In rain pool - waiting...', '#4ade80');
            return;
        }
        
        var join = findJoin();
        if (join) {
            rlog('🔍 JOIN found - clicking!', '#ff922b');
            clickBtn(join);
            rlog('✅ JOIN clicked!', '#4ade80');
            state.rainSuccess++;
            updateRainUI();
        } else {
            if (rainLogLast !== '⏳ No Join') rlog('⏳ No Join button', '#888');
        }
    } catch(e) {
        rlog('⚠️ ' + e.message, '#f87171');
    }
}

// Intercept GraphQL
(function() {
    var orig = window.fetch;
    window.fetch = function() {
        var args = arguments;
        var url = args[0];
        if (typeof url === 'string' && url.includes('/graphql')) {
            try {
                var body = args[1] && args[1].body ? JSON.parse(args[1].body) : null;
                if (body && body.operationName === 'JoinRain') {
                    return orig.apply(this, args).then(async function(res) {
                        var clone = res.clone();
                        var data = await clone.json();
                        var jr = data.data ? data.data.joinRain : null;
                        if (jr) {
                            if (jr.joined) {
                                state.rainSuccess++;
                                rlog('✅ JOIN BERHASIL!', '#4ade80');
                                updateRainUI();
                            } else {
                                state.rainFail++;
                                rlog('❌ GAGAL: ' + (jr.ineligibleReason || 'Unknown'), '#f87171');
                                updateRainUI();
                            }
                        }
                        return res;
                    });
                }
            } catch(e) {}
        }
        return orig.apply(this, args);
    };
})();

