    async function placeBet(betAmount, chance) {
        var cryptoCurrency = getCurrency();
        var rollMode = 'Under';
        var targetNumber = Math.floor((chance / 100) * 10000);

        var query = 'mutation PlaceDiceBet($input: DiceBetInput!) { placeDiceBet(input: $input) { roundId activityId betAmount targetNumber targetNumberLower targetNumberUpper rollMode rolledNumber multiplier winAmount isWin profit timestamp __typename } }';

        var variables = {
            input: {
                betAmount: String(betAmount),
                cryptoCurrency: cryptoCurrency,
                nonce: generateUUID(),
                rollMode: rollMode,
                targetNumber: targetNumber
            }
        };

        var payload = {
            operationName: "PlaceDiceBet",
            query: query,
            variables: variables
        };

        try {
            var response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/graphql-response+json, application/graphql+json, application/json',
                    'Origin': 'https://dicey.com'
                },
                credentials: 'include',
                body: JSON.stringify(payload)
            });

            if (!response.ok) throw new Error('HTTP ' + response.status);
            var data = await response.json();
            if (data.errors) throw new Error(data.errors[0].message);
            return { success: true, data: data.data.placeDiceBet };
        } catch (error) {
            return { success: false, error: error.message };
        }
    }

    async function doBet() {
        if (!wagerState.isRunning || wagerState.isPaused) return null;

        var realBalance = getRealBalance();
        if (realBalance !== null && realBalance > 0) {
            wagerState.currentBalance = realBalance;
        }

        var layer1Bet = 0.01;
        var layer1Chance = 98;
        var layer2Bet = 0.01;
        var layer2Chance = 65;

        if (wagerState.totalBets === 0) {
            wagerState.startBalance = wagerState.currentBalance || 3;
            wagerState.currentBet = layer1Bet;
            wagerState.currentLayer = 1;
            wagerState.startTime = Date.now();
        }

        wagerState.totalBets++;

        var betAmount, chance;
        if (wagerState.currentLayer === 1) {
            betAmount = wagerState.currentBet || layer1Bet;
            chance = layer1Chance;
            wagerState.layer1Bets++;
        } else {
            betAmount = wagerState.currentBet || layer2Bet;
            chance = Math.floor(Math.random() * 25) + 50;
            wagerState.layer2Bets++;
        }

        var result = await placeBet(betAmount, chance);
        if (!result.success) {
            wagerLog('❌ ' + result.error, '#ff6b6b');
            updateWagerUI();
            return null;
        }

        var data = result.data;
        wagerState.wagered += betAmount;
        var profitNum = parseFloat(data.profit) || 0;
        wagerState.currentBalance += profitNum;

        if (data.isWin) {
            wagerState.totalWins++;
            wagerState.currentStreak = wagerState.currentStreak > 0 ? wagerState.currentStreak + 1 : 1;
            if (wagerState.currentLayer === 1) {
                wagerState.currentBet = layer1Bet;
            } else {
                // Back to L1 setelah win di L2
                wagerState.currentLayer = 1;
                wagerState.currentBet = layer1Bet;
                wagerLog('⬆️ Back to L1 after win', '#00e5c0');
            }
        } else {
            wagerState.totalLosses++;
            wagerState.currentStreak = wagerState.currentStreak < 0 ? wagerState.currentStreak - 1 : -1;
            if (wagerState.currentLayer === 1) {
                wagerState.currentLayer = 2;
                wagerState.currentBet = layer2Bet;
                wagerLog('⬇️ Switch to L2 after loss', '#ff922b');
            } else {
                wagerState.currentBet = wagerState.currentBet * 1.1;
                if (wagerState.currentBet > wagerState.currentBalance * 0.5) {
                    wagerState.currentBet = wagerState.currentBalance * 0.5;
                }
            }
        }

        var resultText = data.isWin ? '✅ WIN' : '❌ LOSS';
        var resultColor = data.isWin ? '#00e5c0' : '#ff6b81';
        wagerLog('#' + wagerState.totalBets + ' | ' + betAmount.toFixed(4) + ' USDC | ' + chance + '% | ' + resultText + ' | ' + data.profit, resultColor);

        // Check target & stop loss
        var wagerTarget = 300;
        if (wagerState.wagered >= wagerTarget) {
            wagerLog('🎯 TARGET ' + wagerTarget + ' USDC REACHED!', '#00e5c0');
            stopWagerBot();
            return null;
        }

        var stopLossPercent = 90;
        var stopLoss = wagerState.startBalance * (1 - stopLossPercent / 100);
        if (wagerState.currentBalance <= stopLoss) {
            wagerLog('🛑 STOP LOSS -' + stopLossPercent + '%', '#ff6b6b');
            stopWagerBot();
            return null;
        }

        updateWagerUI();
        return data;
    }

    function wagerLoop() {
        if (!wagerState.isRunning || wagerState.isPaused || wagerState.isLooping) return;
        wagerState.isLooping = true;

        doBet().then(function() {
            wagerState.isLooping = false;
            if (wagerState.isRunning && !wagerState.isPaused) {
                setTimeout(wagerLoop, 1500);
            }
        }).catch(function(e) {
            wagerState.isLooping = false;
            wagerLog('⚠️ Error: ' + e.message, '#ff6b6b');
            setTimeout(wagerLoop, 5000);
        });
    }

    function startWagerBot() {
        if (!isWhitelisted) {
            wagerLog('⚠️ Whitelist required!', '#f87171');
            return;
        }
        if (wagerState.isRunning && !wagerState.isPaused) {
            wagerLog('⚠️ Already running', '#ffd700');
            return;
        }
        if (wagerState.isPaused) {
            wagerState.isPaused = false;
            wagerState.isRunning = true;
            wagerLog('▶️ Resumed', '#00e5c0');
            updateWagerUI();
            setTimeout(wagerLoop, 500);
            updateMasterUI();
            return;
        }

        var realBalance = getRealBalance();
        if (realBalance !== null && realBalance > 0) {
            wagerState.currentBalance = realBalance;
            wagerState.startBalance = realBalance;
            wagerLog('💰 Balance: ' + realBalance.toFixed(4) + ' USDC', '#00e5c0');
        } else {
            wagerState.currentBalance = 3;
            wagerState.startBalance = 3;
            wagerLog('⚠️ Using estimated balance (3 USDC)', '#ffd700');
        }

        wagerState.isRunning = true;
        wagerState.isPaused = false;
        wagerState.totalBets = 0;
        wagerState.totalWins = 0;
        wagerState.totalLosses = 0;
        wagerState.currentStreak = 0;
        wagerState.currentLayer = 1;
        wagerState.currentBet = 0.01;
        wagerState.wagered = 0;
        wagerState.isLooping = false;
        wagerState.startTime = Date.now();

        wagerLog('▶️ WAGER STARTED', '#00e5c0');
        updateWagerUI();
        setTimeout(wagerLoop, 500);
        updateMasterUI();
    }

    function pauseWagerBot() {
        if (!wagerState.isRunning) {
            wagerLog('⚠️ Bot not running', '#ffd700');
            return;
        }
        wagerState.isPaused = !wagerState.isPaused;
        wagerLog(wagerState.isPaused ? '⏸ Paused' : '▶️ Resumed', '#ffd700');
        updateWagerUI();
        if (!wagerState.isPaused) setTimeout(wagerLoop, 500);
        updateMasterUI();
    }

    function stopWagerBot() {
        wagerState.isRunning = false;
        wagerState.isPaused = false;
        wagerState.isLooping = false;
        var profit = wagerState.currentBalance - wagerState.startBalance;
        wagerLog('⏹ STOPPED | ' + (profit >= 0 ? '+' : '') + profit.toFixed(4) + ' USDC', '#ffd700');
        updateWagerUI();
        updateMasterUI();
    }

    function resetWagerBot() {
        stopWagerBot();
        wagerState.totalBets = 0;
        wagerState.totalWins = 0;
        wagerState.totalLosses = 0;
        wagerState.currentStreak = 0;
        wagerState.wagered = 0;
        wagerState.currentLayer = 1;
        var realBalance = getRealBalance();
        if (realBalance !== null && realBalance > 0) {
            wagerState.currentBalance = realBalance;
            wagerState.startBalance = realBalance;
        }
        wagerLog('🔄 RESET', '#ffd700');
        updateWagerUI();
        updateMasterUI();
    }

    function updateWagerToggleUI() {
        var toggleBtn = $('dicey-wager-toggle');
        if (!toggleBtn) return;
        if (wagerState.isRunning && !wagerState.isPaused) {
            toggleBtn.textContent = '■ STOP';
            toggleBtn.style.background = '#ff4757';
            toggleBtn.style.color = '#fff';
        } else if (wagerState.isRunning && wagerState.isPaused) {
            toggleBtn.textContent = '▶ RESUME';
            toggleBtn.style.background = '#ff922b';
            toggleBtn.style.color = '#000';
        } else {
            toggleBtn.textContent = '▶ START';
            toggleBtn.style.background = '#00e5c0';
            toggleBtn.style.color = '#000';
        }
    }

    function toggleWager() {
        if (!isWhitelisted) {
            wagerLog('⚠️ Whitelist required!', '#f87171');
            return;
        }
        if (wagerState.isRunning && !wagerState.isPaused) {
            stopWagerBot();
        } else if (wagerState.isRunning && wagerState.isPaused) {
            pauseWagerBot();
        } else {
            startWagerBot();
        }
        updateMasterUI();
    }

    // ============================================================
    // EVENT LISTENERS - FIXED VERSION
    // ============================================================
    var usernameInput = $('dicey-username');
    var checkWhitelistBtn = $('dicey-check-whitelist');

    if (usernameInput) {
        usernameInput.addEventListener('input', function() { updateWhitelistStatus(); });
        usernameInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                updateWhitelistStatus();
            }
        });
        var savedUsername = localStorage.getItem('dicey_username');
        if (savedUsername) {
            usernameInput.value = savedUsername;
            setTimeout(updateWhitelistStatus, 500);
        }
    }

    if (checkWhitelistBtn) {
        checkWhitelistBtn.addEventListener('click', function(e) {
            e.preventDefault();
            updateWhitelistStatus();
        });
    }

    // Toggles
    var toggleRainEl = document.getElementById('toggle-rain');
    var toggleWagerEl = document.getElementById('toggle-wager');
    var toggleBonusEl = document.getElementById('toggle-bonus');
    
    if (toggleRainEl) toggleRainEl.addEventListener('change', updateToggleVisibility);
    if (toggleWagerEl) toggleWagerEl.addEventListener('change', updateToggleVisibility);
    if (toggleBonusEl) toggleBonusEl.addEventListener('change', updateToggleVisibility);

    // Master
    var masterBtn = document.getElementById('dicey-master');
    if (masterBtn) masterBtn.addEventListener('click', toggleMaster);

    // Rain
    var rainToggleBtn = document.getElementById('dicey-rain-toggle');
    if (rainToggleBtn) rainToggleBtn.addEventListener('click', toggleRain);

    // Wager
    var wagerToggleBtn = document.getElementById('dicey-wager-toggle');
    var wagerPauseBtn = document.getElementById('dicey-wager-pause');
    var wagerResetBtn = document.getElementById('dicey-wager-reset');
    if (wagerToggleBtn) wagerToggleBtn.addEventListener('click', toggleWager);
    if (wagerPauseBtn) wagerPauseBtn.addEventListener('click', pauseWagerBot);
    if (wagerResetBtn) wagerResetBtn.addEventListener('click', resetWagerBot);

    // Bonus
    var bonusToggleBtn = document.getElementById('dicey-bonus-toggle');
    var bonusClaimBtn = document.getElementById('dicey-bonus-claim');
    if (bonusToggleBtn) bonusToggleBtn.addEventListener('click', toggleBonus);
    if (bonusClaimBtn) bonusClaimBtn.addEventListener('click', manualClaim);

    // Minimize
    var minimizeBtn = document.getElementById('dicey-minimize');
    var closeBtn = document.getElementById('dicey-close');
    var content = document.getElementById('dicey-content');
    var minimized = false;

    if (minimizeBtn) {
        minimizeBtn.addEventListener('click', function() {
            minimized = !minimized;
            if (content) content.style.display = minimized ? 'none' : 'block';
            this.textContent = minimized ? '▼' : '▲';
            container.style.height = minimized ? '44px' : 'auto';
        });
    }

    if (closeBtn) {
        closeBtn.addEventListener('click', function() {
            if (wagerState.isRunning) stopWagerBot();
            if (rainIsRunning) stopRain();
            if (bonusState.isRunning) stopBonusAuto();
            container.style.display = 'none';
        });
    }

    // Clear logs
    var clearLogsBtn = document.getElementById('dicey-clear-logs');
    if (clearLogsBtn) {
        clearLogsBtn.addEventListener('click', function() {
            var logEl = document.getElementById('dicey-log');
            if (logEl) logEl.innerHTML = '';
        });
    }

    // Keyboard shortcuts
    document.addEventListener('keydown', function(e) {
        if (e.ctrlKey && e.shiftKey && e.key === 'D') {
            e.preventDefault();
            container.style.display = container.style.display === 'none' ? 'block' : 'none';
        }
        if (e.key === 'Enter' && e.ctrlKey) {
            e.preventDefault();
            toggleMaster();
        }
    });

    // ============================================================
    // INIT
    // ============================================================
    var initialBalance = getRealBalance();
    if (initialBalance !== null && initialBalance > 0) {
        wagerState.currentBalance = initialBalance;
        wagerState.startBalance = initialBalance;
    } else {
        wagerState.currentBalance = 3;
        wagerState.startBalance = 3;
    }

    setTimeout(updateToggleVisibility, 100);
    updateWagerUI();
    updateRainUI();
    updateBonusUI();
    updateMasterUI();

    log('🔥 CheapCheatX Engine v6.1 Ready', '#ff6b35');
    log('🌧️ RAIN: OFF | 🎲 WAGER: OFF | 🎁 BONUS: OFF', '#a0a0a0');
    log('📌 Enter username, click CHECK, then START ALL', '#60a5fa');
    log('⚠️ Error addEventListener FIXED!', '#4ade80');

    console.log('🔥 CheapCheatX Engine v6.1 Loaded (FIXED)');
    console.log('✅ Error addEventListener sudah diperbaiki!');

})();
