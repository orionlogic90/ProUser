    // ============================================================
    // MAIN PROCESS - CYCLE: Add to Rain → Wait → Join → Repeat
    // ============================================================
    function findAndProcessRainButtons() {
        if (!rainState.isRunning || rainState.isProcessing) return;
        
        rainState.processCount++;
        if (rainState.processCount > 4) {
            rainState.processCount = 0;
            rainState.isProcessing = false;
            return;
        }
        
        rainState.isProcessing = true;
        
        try {
            // STEP 1: CEK WIN SPLASH
            if (isWinSplashOpen()) {
                var closeBtn = findWinSplashCloseButton();
                if (closeBtn) {
                    forceClickButton(closeBtn);
                    rainLog('✅ Closed win splash', '#4ade80');
                }
                rainState.status = 'searching';
                updateRainUI();
                rainState.isProcessing = false;
                return;
            }
            
            // STEP 2: CEK "Add to Rain" (SUDAH JOIN)
            var addToRainBtn = findAddToRainButton();
            
            if (addToRainBtn) {
                // SUDAH JOIN - TUNGGU SAMPAI TOMBOL BERUBAH
                if (rainState.lastJoinStatus !== 'joined') {
                    rainState.lastJoinStatus = 'joined';
                    rainState.joinTime = Date.now();
                    rainLog('✅ Already in rain pool - waiting for next rain...', '#4ade80');
                    rainState.status = 'waiting';
                    updateRainUI();
                }
                rainState.isProcessing = false;
                return;
            }
            
            // STEP 3: "Add to Rain" HILANG! RESET STATUS
            if (rainState.lastJoinStatus === 'joined') {
                rainState.lastJoinStatus = null;
                rainLog('🔄 "Add to Rain" gone! Checking for "Join"...', '#60a5fa');
                rainState.status = 'searching';
                updateRainUI();
            }
            
            // STEP 4: CEK APAKAH CHAT TERBUKA
            if (!isChatroomOpen()) {
                var chatTab = findChatTab();
                if (chatTab) {
                    forceClickButton(chatTab);
                    rainState.status = 'opening';
                    updateRainUI();
                    setTimeout(function() {
                        if (rainState.isRunning) {
                            rainState.status = 'searching';
                            updateRainUI();
                        }
                    }, 1000);
                    rainState.isProcessing = false;
                    return;
                }
            }
            
            // STEP 5: CEK TOMBOL JOIN
            var joinBtn = findJoinButton();
            
            if (joinBtn) {
                var isActive = isJoinButtonActive(joinBtn);
                
                if (isActive) {
                    rainLog('🔄 Clicking JOIN button...', '#ff922b');
                    var clicked = forceClickButton(joinBtn);
                    
                    if (clicked) {
                        rainLog('✅ JOIN button clicked! Waiting for response...', '#4ade80');
                        rainState.lastJoinStatus = null;
                        rainState.status = 'searching';
                    } else {
                        rainLog('⚠️ Failed to click JOIN button, retrying...', '#f87171');
                        setTimeout(function() {
                            if (rainState.isRunning) {
                                var retryBtn = findJoinButton();
                                if (retryBtn) {
                                    forceClickButton(retryBtn);
                                    rainLog('🔄 Retry click JOIN', '#ff922b');
                                }
                            }
                        }, 500);
                    }
                    
                    updateRainUI();
                } else {
                    rainLog('ℹ️ JOIN button not active, forcing click anyway...', '#ff922b');
                    forceClickButton(joinBtn);
                }
            } else {
                if (rainState.lastJoinStatus !== 'no_rain') {
                    rainState.lastJoinStatus = 'no_rain';
                    if (rainState.processCount === 1) {
                        rainLog('⏳ No JOIN button available, waiting...', '#888');
                    }
                }
            }
            
            rainState.status = 'searching';
            updateRainUI();
            
        } catch(e) {
            // Silent
        }
        
        rainState.isProcessing = false;
    }

    function clickRainJoin() {
        if (!rainState.isRunning) return;
        
        // CEK WIN SPLASH
        if (isWinSplashOpen()) {
            rainState.status = 'closing_splash';
            updateRainUI();
            var closeBtn = findWinSplashCloseButton();
            if (closeBtn) {
                forceClickButton(closeBtn);
                rainLog('✅ Closed win splash', '#4ade80');
                rainState.status = 'searching';
                updateRainUI();
            }
            return;
        }
        
        // CEK "Add to Rain" (SUDAH JOIN)
        var addToRainBtn = findAddToRainButton();
        if (addToRainBtn) {
            if (rainState.lastJoinStatus !== 'joined') {
                rainState.lastJoinStatus = 'joined';
                rainLog('✅ Already in rain pool - waiting for next rain...', '#4ade80');
                rainState.status = 'waiting';
                updateRainUI();
            }
            // TETAP LANJUT SCAN, JANGAN RETURN!
        }
        
        // CEK APAKAH CHAT TERBUKA
        if (!isChatroomOpen()) {
            var chatTab = findChatTab();
            if (chatTab) {
                rainState.status = 'opening';
                updateRainUI();
                forceClickButton(chatTab);
                rainState.chatOpened = true;
                setTimeout(function() {
                    if (rainState.isRunning) {
                        findAndProcessRainButtons();
                    }
                }, 1000);
                return;
            }
        }
        
        // PROSES LANGSUNG
        findAndProcessRainButtons();
    }

    function startRainBot() {
        if (!isWhitelisted) {
            rainLog('⚠️ Whitelist required!', '#f87171');
            return;
        }
        if (rainState.isRunning) {
            rainLog('⚠️ Already running', '#fbbf24');
            return;
        }

        rainState.username = currentUsername;
        rainState.isRunning = true;
        rainState.successCount = 0;
        rainState.failCount = 0;
        rainState.status = 'idle';
        rainState.lastJoinStatus = null;
        rainState.chatOpened = false;
        rainState.processCount = 0;
        rainState.joinTime = null;
        
        // Reset cache
        DOM_CACHE.chatTab = null;
        DOM_CACHE.joinBtn = null;
        DOM_CACHE.addBtn = null;
        DOM_CACHE.chatOpen = false;
        DOM_CACHE.lastScan = 0;

        var check = WHITELIST.check(currentUsername);
        rainLog('▶️ Rain started @' + rainState.username, '#4ade80');
        rainLog('📋 ' + check.username + ' (' + check.remaining + ')', '#60a5fa');
        rainLog('🔄 Scan every 15 seconds', '#60a5fa');
        rainLog('🔄 Cycle: Join → Add to Rain → Wait → Join → Repeat', '#ff922b');

        // Langsung buka chat dan scan
        setTimeout(function() {
            if (rainState.isRunning) {
                var chatTab = findChatTab();
                if (chatTab) {
                    rainLog('📂 Opening Chat tab...', '#60a5fa');
                    forceClickButton(chatTab);
                    setTimeout(function() {
                        if (rainState.isRunning) {
                            rainLog('✅ Chat opened, scanning for rain...', '#4ade80');
                            findAndProcessRainButtons();
                        }
                    }, 1500);
                } else {
                    rainLog('⚠️ Chat tab not found!', '#f87171');
                    findAndProcessRainButtons();
                }
            }
        }, 1000);
        
        // Interval 15 detik - TERUS SCAN TANPA HENTI
        if (rainState.interval) clearInterval(rainState.interval);
        rainState.interval = setInterval(function() {
            rainState.processCount = 0;
            if (rainState.isRunning) {
                clickRainJoin();
            }
        }, 15000);

        updateRainUI();
    }

    function stopRainBot() {
        rainState.isRunning = false;
        rainState.status = 'idle';
        rainState.lastJoinStatus = null;
        rainState.chatOpened = false;
        rainState.processCount = 0;
        
        DOM_CACHE.chatTab = null;
        DOM_CACHE.joinBtn = null;
        DOM_CACHE.addBtn = null;
        DOM_CACHE.chatOpen = false;
        DOM_CACHE.lastScan = 0;
        
        if (rainState.interval) {
            clearInterval(rainState.interval);
            rainState.interval = null;
        }
        rainLog('⏹️ Rain stopped', '#f87171');
        updateRainUI();
    }

    // ============================================================
    // EVENT LISTENERS
    // ============================================================
    var usernameInput = $('dicey-username');
    var checkWhitelistBtn = $('dicey-check-whitelist');

    if (usernameInput) {
        usernameInput.addEventListener('input', updateWhitelistStatus);
        usernameInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                updateWhitelistStatus();
            }
        });
        var savedUsername = localStorage.getItem('dicey_username');
        if (savedUsername) {
            usernameInput.value = savedUsername;
            updateWhitelistStatus();
        }
    }

    if (checkWhitelistBtn) {
        checkWhitelistBtn.addEventListener('click', function(e) {
            e.preventDefault();
            updateWhitelistStatus();
        });
    }

    // Wager Buttons
    var wagerStartBtn = $('dicey-wager-start');
    var wagerPauseBtn = $('dicey-wager-pause');
    var wagerStopBtn = $('dicey-wager-stop');
    var wagerResetBtn = $('dicey-wager-reset');
    var currencyEl = $('dicey-currency');
    var wagerTargetEl = $('dicey-wager-target-input');

    if (wagerStartBtn) wagerStartBtn.addEventListener('click', startWagerBot);
    if (wagerPauseBtn) wagerPauseBtn.addEventListener('click', pauseWagerBot);
    if (wagerStopBtn) wagerStopBtn.addEventListener('click', stopWagerBot);
    if (wagerResetBtn) wagerResetBtn.addEventListener('click', resetWagerBot);
    if (currencyEl) currencyEl.addEventListener('change', updateWagerUI);
    if (wagerTargetEl) wagerTargetEl.addEventListener('change', updateWagerUI);

    // Rain Buttons
    var rainStartBtn = $('dicey-rain-start');
    var rainStopBtn = $('dicey-rain-stop');

    if (rainStartBtn) rainStartBtn.addEventListener('click', startRainBot);
    if (rainStopBtn) rainStopBtn.addEventListener('click', stopRainBot);

    // Minimize/Close
    var minimized = false;
    var minimizeBtn = $('dicey-minimize');
    var closeBtn = $('dicey-close');

    if (minimizeBtn) {
        minimizeBtn.addEventListener('click', function() {
            minimized = !minimized;
            var content = $('dicey-content');
            if (content) content.style.display = minimized ? 'none' : 'block';
            this.textContent = minimized ? '▼' : '▲';
            container.style.height = minimized ? '44px' : 'auto';
        });
    }

    if (closeBtn) {
        closeBtn.addEventListener('click', function() {
            if (wagerState.isRunning) stopWagerBot();
            if (rainState.isRunning) stopRainBot();
            container.style.display = 'none';
        });
    }

    // Keyboard shortcuts
    document.addEventListener('keydown', function(e) {
        if (e.ctrlKey && e.shiftKey && e.key === 'D') {
            e.preventDefault();
            container.style.display = container.style.display === 'none' ? 'block' : 'none';
        }
        if (e.key === 'Enter' && e.ctrlKey) {
            e.preventDefault();
            if (wagerState.isRunning) stopWagerBot();
            else startWagerBot();
        }
        if (e.key === ' ' && e.ctrlKey) {
            e.preventDefault();
            pauseWagerBot();
        }
    });

    // ============================================================
    // INIT
    // ============================================================
    interceptRainGraphQL();

    var initialBalance = getRealBalance();
    if (initialBalance !== null && initialBalance > 0) {
        wagerState.currentBalance = initialBalance;
        wagerState.startBalance = initialBalance;
    } else {
        wagerState.currentBalance = 3;
        wagerState.startBalance = 3;
    }
    wagerState.username = getUsername();

    switchTab('main');
    setTimeout(updateWhitelistStatus, 100);
    updateWagerUI();
    updateRainUI();
    
    wagerLog('🔥 DiceY engine is READY', '#9ec07c');
    wagerLog('💰 Balance: ~3 USDC', '#00e5c0');
    wagerLog('🎯 Target Wager: 300 USDC', '#ffd700');
    wagerLog('📌 Layer 1: 98% chance, bet 0.01 USDC', '#00e5c0');
    wagerLog('📌 Layer 2: 95% chance, bet 0.01 USDC', '#ff922b');
    wagerLog('🛑 Stop Loss: 90%', '#ff6b6b');
    
    rainLog('✅ Rain Catcher Ready · Enter username to unlock', '#4ade80');
    rainLog('📡 API interceptor active', '#60a5fa');
    rainLog('🔄 Scan every 15 seconds', '#60a5fa');
    rainLog('🔄 Cycle: Join → Add to Rain → Wait → Join → Repeat', '#ff922b');

    console.log('⚡ DiceY engine is READY');
    console.log('📌 Enter username first to unlock both bots');
    console.log('🎯 Target Wager: 300 USDC');
    console.log('💰 Balance: ~3 USDC');
    console.log('📌 Ctrl+Enter: start/stop wager | Ctrl+Space: pause');
    console.log('🔄 Rain Cycle: Join → Add to Rain → Wait → Join → Repeat');

})();
