    async function claimAllBonuses() {
        if (bonusState.isProcessing) {
            bonusLog('⏳ Already processing...', '#fbbf24');
            return;
        }
        if (!isWhitelisted) {
            bonusLog('⚠️ Whitelist required!', '#f87171');
            return;
        }
        bonusState.isProcessing = true;
        bonusLog('🔄 Checking bonuses...', '#60a5fa');

        try {
            var profileBtn = findProfileButton();
            if (!profileBtn) {
                bonusLog('❌ Profile button not found', '#f87171');
                bonusState.isProcessing = false;
                return;
            }
            forceClickButton(profileBtn);
            await sleep(1000);

            var bonusTypes = [];
            if (document.getElementById('bonus-instant')?.checked) bonusTypes.push('Instant Rakeback');
            if (document.getElementById('bonus-daily')?.checked) bonusTypes.push('Daily Bonus');
            if (document.getElementById('bonus-freespin')?.checked) bonusTypes.push('Free Spins');
            if (document.getElementById('bonus-weekly')?.checked) bonusTypes.push('Weekly Bonus');

            var claimed = 0;
            for (var i = 0; i < bonusTypes.length; i++) {
                var success = await claimSingleBonus(bonusTypes[i]);
                if (success) claimed++;
                await sleep(500);
            }

            var closeBtn = findCloseMenu();
            if (closeBtn) {
                forceClickButton(closeBtn);
                bonusLog('✅ Closed profile menu', '#4ade80');
            } else {
                bonusLog('⚠️ No close button, clicking outside', '#fbbf24');
                document.body.click();
                await sleep(300);
                if (document.querySelector('[class*="menu"]') || document.querySelector('[class*="popup"]')) {
                    bonusLog('🔄 Trying ESC key', '#fbbf24');
                    closeMenuWithEscape();
                }
            }

            if (claimed > 0) {
                bonusState.totalClaimed += claimed;
                bonusState.lastClaim = Date.now();
                bonusLog('🎉 Total claimed: ' + claimed + ' bonuses', '#ff6b9d');
            } else {
                bonusLog('ℹ️ No bonuses available', '#888');
            }
            updateBonusUI();

        } catch(e) {
            bonusLog('❌ Error: ' + e.message, '#f87171');
        }
        bonusState.isProcessing = false;
    }

    function startBonusAuto() {
        if (!isWhitelisted) {
