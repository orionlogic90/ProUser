    async function checkWhitelist(username) {
        var data = await fetchWhitelist();
        var users = data.users || {};
        username = username.toLowerCase().trim();
        if (!username) return { valid: false, reason: 'Enter username' };
        if (!users[username]) return { valid: false, reason: 'User not in whitelist' };
        var expiry = users[username];
        if (expiry === 'permanent') return { valid: true, username: username, remaining: '∞' };
        var expiryDate = new Date(expiry);
        if (new Date() > expiryDate) return { valid: false, reason: 'License expired (' + expiry + ')' };
        var remaining = Math.ceil((expiryDate - new Date()) / (1000 * 60 * 60 * 24));
        return { valid: true, username: username, remaining: remaining + ' days' };
    }

