// ============================================================
// DICEY RAIN CATCHER v3.2 - UI PERMANEN TIDAK PERNAH TUTUP
// Loop 30 Menit + UI Tetap Terlihat
// ============================================================

(function() {
    'use strict';

    const CONFIG = {
        CHECK_INTERVAL: 30000,      // 30 detik
        LOOP_INTERVAL: 1800000,     // 30 menit
        MAX_RETRY: 3,
        DEBUG: true
    };

    const state = {
        isRunning: false,
        successCount: 0,
        failCount: 0,
        interval: null,
        loopInterval: null,
        username: '',
        status: 'idle',
        isMobile: false,
        lastJoinAttempt: 0,
        loopCount: 0,
        isJoining: false
    };

    // ============================================================
    // LOGGER
    // ============================================================
    function log(msg, color = '#888') {
        const logEl = document.getElementById('dicey-log');
        if (!logEl) {
            console.log(`[${new Date().toLocaleTimeString()}] ${msg}`);
            return;
        }
        
        const time = new Date().toLocaleTimeString();
        logEl.innerHTML += `<div style="color:${color};padding:4px 0;border-bottom:1px solid rgba(255,255,255,0.05);font-size:11px;font-family:monospace;">${time} ${msg}</div>`;
        logEl.scrollTop = logEl.scrollHeight;
        
        if (logEl.children.length > 100) {
            logEl.removeChild(logEl.firstChild);
        }
    }

    function logLoop(msg, color = '#a78bfa') {
        log(`🔄 [LOOP ${state.loopCount}] ${msg}`, color);
    }

    // ============================================================
    // SLEEP
    // ============================================================
    function sleep(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    // ============================================================
    // DOM UTILITIES
    // ============================================================
    
    function isVisible(el) {
        if (!el) return false;
        const rect = el.getBoundingClientRect();
        const style = window.getComputedStyle(el);
        return (
            rect.width > 0 &&
            rect.height > 0 &&
            style.display !== 'none' &&
            style.visibility !== 'hidden' &&
            style.opacity !== '0' &&
            el.offsetParent !== null
        );
    }

    function isMobileViewport() {
        return window.innerWidth < 768 || window.innerHeight < 600;
    }

    // ============================================================
    // FIND CHAT TAB
    // ============================================================
    function findChatTab() {
        state.isMobile = isMobileViewport();
        
        if (state.isMobile) {
            const mobileSelectors = [
                '[data-test-id="mobile-bottom-nav"] a:nth-of-type(4)',
                '[data-test-id="mobile-bottom-nav"] a[aria-label*="Chat"]',
                '[data-test-id="mobile-bottom-nav"] a[aria-label*="chat"]',
                '[data-test-id="mobile-bottom-nav"] div a:nth-child(4)'
            ];
            
            for (const selector of mobileSelectors) {
                try {
                    const el = document.querySelector(selector);
                    if (el && isVisible(el)) return el;
                } catch (e) {}
            }
        }
        
        const desktopSelectors = [
            '[role="tab"][aria-label*="Chat"]',
            '[role="tab"][aria-label*="chat"]',
            '.chat-tab',
            '.tab-chat',
            '[class*="chat"][class*="tab"]',
            'button[aria-label*="Chat"]',
            '.str-chat__channel-list',
            '[data-testid="chat-tab"]'
        ];
        
        for (const selector of desktopSelectors) {
            try {
                const el = document.querySelector(selector);
                if (el && isVisible(el)) return el;
            } catch (e) {}
        }
        
        const allButtons = document.querySelectorAll('button, a, [role="tab"]');
        for (const el of allButtons) {
            const text = (el.textContent || '').trim();
            if (text === 'Chat' || text === 'CHAT') {
                if (isVisible(el)) return el;
            }
        }
        
        return null;
    }

    // ============================================================
    // FIND JOIN BUTTON
    // ============================================================
    function findJoinButton() {
        const selectors = [
            'div.shrink-0 button.font-small-1-semibold',
            '#str-chat__channel button.font-small-1-semibold',
            'button[aria-label="Join"]',
            'button[aria-label*="join"]',
            '.join-btn',
            '.join-rain-btn',
            '.btn-join',
            '[class*="join"][class*="rain"]',
            '[class*="join"][class*="btn"]',
            '[data-testid="join-rain-btn"]',
            '[data-cy="join-rain"]',
            '.str-chat__message-join',
            '[class*="join-rain"]'
        ];
        
        for (const selector of selectors) {
            try {
                const elements = document.querySelectorAll(selector);
                for (const el of elements) {
                    const text = (el.textContent || '').trim().toLowerCase();
                    if (isVisible(el) && !el.disabled) {
                        if (text === 'join' || 
                            text.includes('join') || 
                            el.getAttribute('aria-label')?.toLowerCase().includes('join')) {
                            return el;
                        }
                    }
                }
            } catch (e) {}
        }
        
        const containers = document.querySelectorAll('*');
        for (const container of containers) {
            const text = (container.textContent || '');
            if (text.includes('Rain Pool') || text.includes('Rain')) {
                const btn = container.querySelector('button:not([disabled])');
                if (btn && isVisible(btn)) {
                    const btnText = (btn.textContent || '').trim().toLowerCase();
                    if (btnText === 'join' || btnText.includes('join')) {
                        return btn;
                    }
                }
            }
        }
        
        return null;
    }

    // ============================================================
    // FIND CLOSE/SPLASH BUTTON
    // ============================================================
    function findCloseButton() {
        const selectors = [
            '[class*="close"]',
            '[class*="dismiss"]',
            '[aria-label="Close"]',
            '[class*="modal-close"]',
            '[class*="popup-close"]',
            '[class*="splash-close"]',
            'button[aria-label*="Close"]'
        ];
        
        for (const selector of selectors) {
            try {
                const el = document.querySelector(selector);
                if (el && isVisible(el)) return el;
            } catch (e) {}
        }
        
        const buttons = document.querySelectorAll('button');
        for (const btn of buttons) {
            const text = (btn.textContent || '').trim();
            if (text === '✕' || text === '×' || text === 'X' || text === 'x') {
                if (isVisible(btn)) return btn;
            }
        }
        
        return null;
    }

    // ============================================================
    // CHECK RAIN POOL OPEN
    // ============================================================
    function isRainPoolOpen() {
        const indicators = [
            'Rain Pool',
            'Rain',
            'rain-pool',
            '[class*="rain-pool"]',
            '[class*="rain"][class*="pool"]'
        ];
        
        for (const indicator of indicators) {
            try {
                const el = document.querySelector(indicator);
                if (el && isVisible(el)) return true;
            } catch (e) {}
            
            const allEls = document.querySelectorAll('*');
            for (const el of allEls) {
                if (el.textContent && el.textContent.includes('Rain Pool')) {
                    if (isVisible(el)) return true;
                }
            }
        }
        
        return false;
    }

    // ============================================================
    // CHECK APAKAH SUDAH JOIN
    // ============================================================
    function isAlreadyJoined() {
        const buttons = document.querySelectorAll('button, [role="button"]');
        for (const btn of buttons) {
            const text = (btn.textContent || '').trim().toLowerCase();
            if (text === 'add to rain' || text.includes('add to rain')) {
                if (isVisible(btn)) return true;
            }
        }
        return false;
    }

    // ============================================================
    // MAIN LOGIC - AUTO JOIN
    // ============================================================
    async function autoJoin() {
        if (!state.isRunning) return;
        if (state.isJoining) {
            log('⏳ Still processing...', '#fbbf24');
            return;
        }
        
        state.isJoining = true;
        state.status = 'searching';
        updateUI();
        
        try {
            // STEP 1: Tutup splash screen
            const closeBtn = findCloseButton();
            if (closeBtn) {
                log('❌ Closing splash screen...', '#fbbf24');
                closeBtn.click();
                await sleep(500);
            }
            
            // STEP 2: Cek Chat Tab
            const chatTab = findChatTab();
            const chatOpen = isRainPoolOpen();
            
            if (!chatOpen) {
                if (chatTab) {
                    log('📂 Opening chat tab...', '#60a5fa');
                    chatTab.click();
                    await sleep(1000);
                } else {
                    log('⚠️ Chat tab not found', '#fbbf24');
                }
            }
            
            // STEP 3: Cek sudah join
            if (isAlreadyJoined()) {
                log('✅ Already joined this rain!', '#4ade80');
                state.status = 'already_joined';
                updateUI();
                state.isJoining = false;
                return;
            }
            
            // STEP 4: Cari dan klik Join
            const joinBtn = findJoinButton();
            if (joinBtn && !joinBtn.disabled) {
                const btnText = (joinBtn.textContent || '').trim();
                log(`🔄 Clicking "${btnText}" button...`, '#4ade80');
                
                state.status = 'joining';
                updateUI();
                
                // Multiple click events
                joinBtn.click();
                joinBtn.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
                joinBtn.dispatchEvent(new MouseEvent('mouseup', { bubbles: true }));
                joinBtn.dispatchEvent(new MouseEvent('click', { bubbles: true }));
                
                state.lastJoinAttempt = Date.now();
                state.successCount++;
                
                log('✅ Join button clicked!', '#4ade80');
                state.status = 'success';
                updateUI();
                
                log('💬 UI TETAP TERBUKA - Menunggu loop berikutnya', '#4ade80');
                
            } else {
                if (chatOpen) {
                    log('⏳ Rain pool open - no Join button', '#fbbf24');
                } else {
                    log('⏳ No rain available', '#888');
                }
                state.status = 'idle';
                updateUI();
            }
            
        } catch (error) {
            log(`❌ Error: ${error.message}`, '#f87171');
            state.failCount++;
            updateUI();
        }
        
        state.isJoining = false;
    }

    // ============================================================
    // LOOP 30 MENIT
    // ============================================================
    async function loop30Minutes() {
        if (!state.isRunning) return;
        
        state.loopCount++;
        const nextLoop = new Date(Date.now() + CONFIG.LOOP_INTERVAL);
        
        logLoop(`⏰ 30-MINUTE LOOP #${state.loopCount} STARTED`, '#a78bfa');
        logLoop(`Next loop at: ${nextLoop.toLocaleTimeString()}`, '#a78bfa');
        
        state.status = 'loop_start';
        updateUI();
        
        await autoJoin();
        
        logLoop(`✅ Loop #${state.loopCount} completed`, '#4ade80');
        state.status = 'loop_complete';
        updateUI();
        
        // 🔥 PASTIKAN UI TETAP TERLIHAT
        ensureUIVisible();
    }

    // ============================================================
    // 🔥 PASTIKAN UI SELALU TERLIHAT
    // ============================================================
    function ensureUIVisible() {
        const ui = document.getElementById('dicey-rain-ui');
        if (ui) {
            ui.style.display = 'block !important';
            ui.style.visibility = 'visible !important';
            ui.style.opacity = '1 !important';
            ui.style.zIndex = '999999 !important';
            ui.style.pointerEvents = 'auto !important';
            
            // Cek apakah UI di dalam DOM
            if (!document.body.contains(ui)) {
                document.body.appendChild(ui);
                log('🔧 UI re-attached to DOM', '#fbbf24');
            }
        } else {
            // Kalau UI hilang, buat ulang
            log('🔧 UI hilang, membuat ulang...', '#f87171');
            createUI();
        }
    }

    // ============================================================
    // MUTATION OBSERVER - Pantau perubahan DOM
    // ============================================================
    function setupUIMonitor() {
        const observer = new MutationObserver(() => {
            const ui = document.getElementById('dicey-rain-ui');
            if (ui && ui.style.display === 'none') {
                // Kalau UI disembunyikan, tampilkan lagi
                ui.style.display = 'block';
                log('🔧 UI was hidden, showing again', '#fbbf24');
            }
        });
        
        observer.observe(document.body, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['style', 'class']
        });
        
        return observer;
    }

    // ============================================================
    // START / STOP
    // ============================================================
    function startBot() {
        const usernameInput = document.getElementById('dicey-username');
        if (!usernameInput || !usernameInput.value.trim()) {
            log('⚠️ Enter username first!', '#f87171');
            usernameInput?.focus();
            return;
        }
        
        if (state.isRunning) {
            log('⚠️ Bot already running', '#fbbf24');
            return;
        }
        
        state.username = usernameInput.value.trim();
        state.isRunning = true;
        state.successCount = 0;
        state.failCount = 0;
        state.loopCount = 0;
        state.isMobile = isMobileViewport();
        state.isJoining = false;
        
        log(`▶️ Bot started for @${state.username}`, '#4ade80');
        log(`📱 ${state.isMobile ? 'Mobile' : 'Desktop'} mode`, '#60a5fa');
        log(`⏰ Loop: ${CONFIG.LOOP_INTERVAL/60000} minutes`, '#60a5fa');
        log(`💬 UI TIDAK AKAN PERNAH TUTUP!`, '#4ade80');
        
        // First run
        setTimeout(async () => {
            await autoJoin();
            if (state.interval) clearInterval(state.interval);
            state.interval = setInterval(autoJoin, CONFIG.CHECK_INTERVAL);
        }, 1000);
        
        // Loop 30 menit
        if (state.loopInterval) clearInterval(state.loopInterval);
        state.loopInterval = setInterval(loop30Minutes, CONFIG.LOOP_INTERVAL);
        
        setTimeout(() => {
            if (state.isRunning) loop30Minutes();
        }, CONFIG.LOOP_INTERVAL);
        
        updateUI();
    }

    function stopBot() {
        state.isRunning = false;
        state.status = 'idle';
        state.isJoining = false;
        
        if (state.interval) {
            clearInterval(state.interval);
            state.interval = null;
        }
        if (state.loopInterval) {
            clearInterval(state.loopInterval);
            state.loopInterval = null;
        }
        
        log('⏹️ Bot stopped', '#f87171');
        log(`📊 ${state.successCount} success, ${state.failCount} failed`, '#888');
        updateUI();
    }

    // ============================================================
    // UPDATE UI
    // ============================================================
    function updateUI() {
        const statusEl = document.getElementById('dicey-status');
        const dotEl = document.getElementById('dicey-dot');
        const subEl = document.getElementById('dicey-sub-status');
        const successEl = document.getElementById('dicey-success-count');
        const failEl = document.getElementById('dicey-fail-count');
        const loopEl = document.getElementById('dicey-loop-count');
        const startBtn = document.getElementById('dicey-start-btn');
        
        if (state.isRunning) {
            dotEl.style.background = '#4ade80';
            statusEl.textContent = '● RUNNING';
            statusEl.style.color = '#4ade80';
            
            const statusMap = {
                'idle': '⏳ Waiting for rain...',
                'searching': '🔍 Searching...',
                'joining': '🔄 Joining...',
                'success': '✅ Joined!',
                'failed': '❌ Failed',
                'already_joined': '✅ Already joined',
                'loop_start': '🔄 Loop started...',
                'loop_complete': '✅ Loop complete'
            };
            subEl.textContent = statusMap[state.status] || '⏳ Active';
            subEl.style.color = '#60a5fa';
            
            if (loopEl) {
                loopEl.textContent = `🔄 Loop ${state.loopCount}`;
                loopEl.style.color = '#a78bfa';
            }
        } else {
            dotEl.style.background = '#888';
            statusEl.textContent = '○ STOPPED';
            statusEl.style.color = '#888';
            subEl.textContent = '⏸️ Idle';
            subEl.style.color = '#888';
            if (loopEl) {
                loopEl.textContent = '⏸️ Stopped';
                loopEl.style.color = '#888';
            }
        }
        
        if (successEl) successEl.textContent = state.successCount;
        if (failEl) failEl.textContent = state.failCount;
        if (startBtn) {
            startBtn.textContent = state.isRunning ? '● RUNNING' : '▶ START';
            startBtn.style.opacity = state.isRunning ? '0.6' : '1';
        }
    }

    // ============================================================
    // CREATE UI - PERMANEN, TIDAK PERNAH TUTUP
    // ============================================================
    function createUI() {
        const existing = document.getElementById('dicey-rain-ui');
        if (existing) existing.remove();
        
        const container = document.createElement('div');
        container.id = 'dicey-rain-ui';
        container.style.cssText = `
            position: fixed !important;
            bottom: 20px !important;
            right: 20px !important;
            width: 360px !important;
            max-width: 90vw !important;
            background: #0d1117 !important;
            color: #e6edf3 !important;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
            border-radius: 12px !important;
            border: 2px solid #4ade80 !important;
            box-shadow: 0 8px 32px rgba(0,0,0,0.9) !important;
            z-index: 999999 !important;
            padding: 16px 18px !important;
            font-size: 13px !important;
            user-select: none !important;
            backdrop-filter: blur(10px) !important;
            pointer-events: auto !important;
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        `;
        
        container.innerHTML = `
            <!-- Header -->
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
                <div style="display:flex;align-items:center;gap:8px;">
                    <span style="font-weight:700;font-size:15px;color:#f0f6fc;">🎲 Auto Join</span>
                    <span style="font-size:9px;color:#4ade80;background:#1a2e1a;padding:2px 8px;border-radius:10px;">● LIVE</span>
                </div>
                <button id="dicey-close" style="background:none;border:none;color:#8b949e;font-size:16px;cursor:pointer;padding:0 4px;">✕</button>
            </div>
            
            <!-- Username -->
            <div style="margin-bottom:10px;">
                <input id="dicey-username" type="text" placeholder="Enter username..." style="width:100%;padding:8px 12px;border-radius:6px;border:1px solid #30363d;background:#0d1117;color:#e6edf3;font-size:13px;box-sizing:border-box;outline:none;">
            </div>
            
            <!-- Buttons -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:12px;">
                <button id="dicey-start-btn" style="padding:8px 0;border:none;border-radius:6px;background:#238636;color:#fff;font-weight:600;font-size:13px;cursor:pointer;">▶ START</button>
                <button id="dicey-stop-btn" style="padding:8px 0;border:none;border-radius:6px;background:#21262d;color:#e6edf3;font-weight:600;font-size:13px;cursor:pointer;opacity:0.4;">■ STOP</button>
            </div>
            
            <!-- Status -->
            <div style="padding:10px 0;border-top:1px solid #21262d;border-bottom:1px solid #21262d;margin-bottom:10px;">
                <div style="display:flex;align-items:center;gap:8px;">
                    <span id="dicey-dot" style="width:6px;height:6px;border-radius:50%;background:#888;display:inline-block;"></span>
                    <span id="dicey-status" style="font-size:12px;font-weight:500;color:#888;">○ STOPPED</span>
                    <span style="margin-left:auto;font-size:11px;display:flex;gap:12px;">
                        <span style="color:#4ade80;">✓ <span id="dicey-success-count">0</span></span>
                        <span style="color:#f87171;">✗ <span id="dicey-fail-count">0</span></span>
                        <span id="dicey-loop-count" style="color:#a78bfa;">⏸️ Stopped</span>
                    </span>
                </div>
                <div id="dicey-sub-status" style="font-size:11px;color:#888;margin-top:4px;padding-left:14px;">⏸️ Idle</div>
            </div>
            
            <!-- Info Loop -->
            <div style="padding:6px 0;margin-bottom:8px;font-size:10px;color:#a78bfa;text-align:center;border-bottom:1px solid #1a1a2e;">
                ⏰ Next loop: <span id="dicey-next-loop">Not started</span>
            </div>
            
            <!-- Log -->
            <div id="dicey-log" style="background:#0d1117;border-radius:6px;padding:4px 0;max-height:120px;overflow-y:auto;font-size:11px;color:#8b949e;font-family:monospace;line-height:1.6;"></div>
            
            <!-- Footer -->
            <div style="margin-top:8px;font-size:9px;color:#4ade80;text-align:center;border-top:1px solid #1a2e1a;padding-top:8px;">
                🔄 Loop 30m · UI PERMANEN · Ctrl+Enter toggle
            </div>
        `;
        
        document.body.appendChild(container);
        
        // EVENTS
        document.getElementById('dicey-start-btn').onclick = startBot;
        document.getElementById('dicey-stop-btn').onclick = stopBot;
        
        // ✕ CLOSE - JANGAN HILANGKAN UI, hanya minimize
        document.getElementById('dicey-close').onclick = () => {
            const ui = document.getElementById('dicey-rain-ui');
            if (ui) {
                ui.style.width = '50px';
                ui.style.height = '40px';
                ui.style.overflow = 'hidden';
                ui.style.padding = '8px 10px';
                ui.innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;height:100%;">
                    <span style="font-size:12px;font-weight:700;color:#4ade80;">🎲</span>
                    <button id="dicey-restore" style="background:none;border:none;color:#4ade80;font-size:14px;cursor:pointer;">⤢</button>
                </div>`;
                
                document.getElementById('dicey-restore').onclick = () => {
                    location.reload(); // Reload buat restore UI
                };
            }
        };
        
        document.getElementById('dicey-username').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') startBot();
        });
        
        // Keyboard shortcut
        document.addEventListener('keydown', (e) => {
            if (e.ctrlKey && e.key === 'Enter') {
                e.preventDefault();
                state.isRunning ? stopBot() : startBot();
            }
        });
        
        // DRAG
        let isDragging = false, offsetX, offsetY;
        const header = container.querySelector('div:first-child');
        header.addEventListener('mousedown', (e) => {
            if (e.target.closest('button')) return;
            isDragging = true;
            const rect = container.getBoundingClientRect();
            offsetX = e.clientX - rect.left;
            offsetY = e.clientY - rect.top;
            container.style.cursor = 'grabbing';
        });
        document.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            let x = e.clientX - offsetX;
            let y = e.clientY - offsetY;
            x = Math.max(0, Math.min(window.innerWidth - container.offsetWidth, x));
            y = Math.max(0, Math.min(window.innerHeight - container.offsetHeight, y));
            container.style.left = x + 'px';
            container.style.right = 'auto';
            container.style.bottom = 'auto';
            container.style.top = y + 'px';
        });
        document.addEventListener('mouseup', () => {
            isDragging = false;
            container.style.cursor = '';
        });
        
        // UPDATE NEXT LOOP
        setInterval(() => {
            if (state.isRunning) {
                const nextLoopEl = document.getElementById('dicey-next-loop');
                if (nextLoopEl) {
                    const nextTime = new Date(Date.now() + CONFIG.LOOP_INTERVAL);
                    nextLoopEl.textContent = nextTime.toLocaleTimeString();
                }
            }
        }, 10000);
        
        log('✅ Bot ready! Enter username & START', '#4ade80');
        log('🔒 UI PERMANEN - Tidak akan pernah hilang!', '#4ade80');
        log('🔄 Loop 30 menit otomatis', '#a78bfa');
        
        // 🔥 SETUP UI MONITOR
        setupUIMonitor();
        
        updateUI();
    }

    // ============================================================
    // INIT
    // ============================================================
    let uiMonitor = null;
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            createUI();
            uiMonitor = setupUIMonitor();
        });
    } else {
        createUI();
        uiMonitor = setupUIMonitor();
    }
    
    // 🔥 CEK UI SETIAP 5 DETIK - PASTIKAN TIDAK HILANG
    setInterval(() => {
        const ui = document.getElementById('dicey-rain-ui');
