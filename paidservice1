    // ============================================================
    // RAIN INTERCEPT GRAPHQL
    // ============================================================
    (function() {
        var originalFetch = window.fetch;
        window.fetch = function(...args) {
            var url = args[0];
            var options = args[1] || {};
            if (typeof url === 'string' && url.includes('/graphql')) {
                var body = null;
                try { body = options.body ? JSON.parse(options.body) : null; } catch(e) {}
                if (body && body.operationName === 'JoinRain') {
                    var potId = body.variables ? body.variables.potId || 'unknown' : 'unknown';
                    return originalFetch.apply(this, args).then(async function(response) {
                        var clonedResponse = response.clone();
                        var data = await clonedResponse.json();
                        var joinResult = data.data ? data.data.joinRain : null;
                        if (joinResult) {
                            if (joinResult.joined === true) {
                                rainSuccessCount++;
                                rainLog('✅ JOIN BERHASIL! (PotID: ' + potId.substring(0,8) + ')', '#4ade80');
                                updateRainUI();
                            } else {
                                rainFailCount++;
                                var reason = joinResult.ineligibleReason || 'Unknown';
                                rainLog('❌ JOIN GAGAL: ' + reason, '#f87171');
                                updateRainUI();
                            }
                        }
                        return response;
                    });
                }
            }
            return originalFetch.apply(this, args);
        };
    })();

