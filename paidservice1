    // ====== MAIN SCAN FUNCTION ======
    function scanRain() {
        if (!rainIsRunning || rainIsProcessing) return;
        rainIsProcessing = true;

        console.log('🔄 Scanning for rain...');

        try {
            // STEP 1: Cek apakah di Chat
            var inChat = isInChat();
            
            if (!inChat) {
