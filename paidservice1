function $(id) { return document.getElementById(id); }

function log(msg, color) {
    color = color || '#888';
    var el = $('main-log');
    if (!el) return;
    var t = new Date().toLocaleTimeString();
    el.innerHTML += '<div style="color:' + color + ';padding:1px 0;font-size:8px;">[' + t + '] ' + msg + '</div>';
    el.scrollTop = el.scrollHeight;
    if (el.children.length > 100) el.removeChild(el.firstChild);
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

function genUUID() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
        var r = Math.random() * 16 | 0;
        var v = c === 'x' ? r : (r & 0x3 | 0x8);
        return v.toString(16);
    });
}

function getBalance() {
    try {
        var els = document.querySelectorAll('[class*="balance"]');
        for (var i = 0; i < els.length; i++) {
            var t = els[i].textContent.trim();
            var m = t.match(/(\d+\.?\d*)/);
            if (m) { var n = parseFloat(m[1]); if (n > 0) return n; }
        }
        return null;
    } catch(e) { return null; }
}

