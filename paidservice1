        var nav = document.querySelector('[data-test-id="mobile-bottom-nav"]');
        if (nav) {
            var links = nav.querySelectorAll('a, button, [role="tab"]');
            for (var i = 0; i < links.length; i++) {
                var link = links[i];
                var text = link.textContent ? link.textContent.trim() : '';
                var aria = link.getAttribute('aria-label') || '';
                console.log('📱 Nav item: "' + text + '" aria: "' + aria + '"');
                if (text === 'Chat' || text.includes('Chat') || text === '💬' || aria === 'Chat' || aria.includes('Chat')) {
                    var rect = link.getBoundingClientRect();
                    if (rect.width > 0 && rect.height > 0) {
                        console.log('✅ Found Chat tab in nav:', link);
                        return link;
                    }
                }
            }
        }

