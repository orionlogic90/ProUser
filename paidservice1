        var time = new Date().toLocaleTimeString();
        logEl.innerHTML += '<div style="color:' + color + ';padding:2px 0;border-bottom:1px solid rgba(255,255,255,0.02);font-size:8px;">[' + time + '] ' + msg + '</div>';
