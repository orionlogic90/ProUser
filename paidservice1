    var sel = ['header img[alt*="avatar"]', 'header [class*="avatar"] img', '[data-testid="user-menu"] img'];
    for (var i = 0; i < sel.length; i++) {
        var el = document.querySelector(sel[i]);
        if (el) {
            var r = el.getBoundingClientRect();
            if (r.width > 0 && r.height > 0) {
                var p = el.closest('button, [role="button"]');
                return p || el;
            }
        }
    }
    return null;
}

async function claimBonus() {
    if (!state.isWhitelisted) { log('⚠️ Whitelist required!', '#f87171'); return; }
    log('🔄 Checking bonuses...', '#60a5fa');
    
    try {
        var profile = findProfile();
        if (!profile) { log('❌ Profile not found', '#f87171'); return; }
        clickBtn(profile);
        await sleep(800);
        
        var types = ['Instant Rakeback', 'Daily Bonus', 'Free Spins', 'Weekly Bonus'];
        var claimed = 0;
        
        for (var i = 0; i < types.length; i++) {
            var tab = findBonusTab(types[i]);
            if (tab) {
                clickBtn(tab);
                await sleep(600);
                var claim = findClaim();
                if (claim) {
                    clickBtn(claim);
                    await sleep(400);
                    log('✅ ' + types[i] + ' claimed!', '#4ade80');
                    claimed++;
                }
            }
            await sleep(300);
        }
        
        if (claimed > 0) {
            state.bonusClaimed += claimed;
            var last = $('b-last');
            if (last) last.textContent = new Date().toLocaleTimeString();
            var count = $('b-count');
            if (count) count.textContent = state.bonusClaimed;
            log('🎉 ' + claimed + ' bonuses claimed!', '#ff6b9d');
        } else {
            log('ℹ️ No bonuses available', '#888');
        }
        
        // Close menu
        var close = document.querySelector('[aria-label="Close"]');
        if (close) clickBtn(close);
        
    } catch(e) {
        log('❌ ' + e.message, '#f87171');
    }
}

function toggleBonus() {
    if (!state.isWhitelisted) { log('⚠️ Whitelist required!', '#f87171'); return; }
    if (state.bonusRunning) {
        state.bonusRunning = false;
        if (state.bonusInterval) { clearInterval(state.bonusInterval); state.bonusInterval = null; }
        log('⏹️ Bonus auto stopped', '#f87171');
        var btn = $('bonus-btn');
        if (btn) { btn.textContent = '▶ AUTO'; btn.style.background = '#ff6b9d'; btn.style.color = '#000'; }
    } else {
        state.bonusRunning = true;
        log('▶️ Bonus auto started', '#4ade80');
        var btn = $('bonus-btn');
        if (btn) { btn.textContent = '■ STOP'; btn.style.background = '#ff4757'; btn.style.color = '#fff'; }
        if (state.bonusInterval) { clearInterval(state.bonusInterval); }
        state.bonusInterval = setInterval(claimBonus, 60000);
        setTimeout(claimBonus, 1000);
    }
}

