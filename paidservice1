        if (bal !== null && bal > 0) {
            state.wagerBalance = bal;
            state.wagerStartBalance = bal;
        }
    } else {
        status.textContent = '❌ ' + result.reason;
        status.style.color = '#f87171';
        state.isWhitelisted = false;
    }
    updateLocks();
    updateWagerUI();
}

function updateLocks() {
    var locked = !state.isWhitelisted;
    var locks = ['rain-lock', 'wager-lock', 'bonus-lock'];
    var btns = ['rain-btn', 'wager-btn', 'bonus-btn', 'bonus-claim', 'dicey-master'];
    
    locks.forEach(function(id) {
        var el = $(id);
        if (el) {
            el.textContent = locked ? '🔒 Locked' : '✅ Unlocked';
            el.style.color = locked ? '#ff6b81' : '#4ade80';
        }
    });
    
    btns.forEach(function(id) {
        var el = $(id);
        if (el) {
            el.style.opacity = locked ? '0.3' : '1';
            el.style.cursor = locked ? 'not-allowed' : 'pointer';
        }
    });
}

