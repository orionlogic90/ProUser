    function getRealBalance() {
        try {
            var selectors = ['[class*="balance"]', '[class*="Balance"]', '[data-testid="balance"]', '.balance-amount'];
            for (var i = 0; i < selectors.length; i++) {
                var elements = document.querySelectorAll(selectors[i]);
                for (var j = 0; j < elements.length; j++) {
                    var text = elements[j].textContent.trim();
                    var match = text.match(/(\d+\.?\d*)/);
                    if (match) {
                        var num = parseFloat(match[1]);
                        if (num > 0) return num;
                    }
                }
            }
            return null;
        } catch(e) { return null; }
    }

    async function placeBet(amount, chance) {
        var target = Math.floor((chance / 100) * 10000);
        var query = 'mutation PlaceDiceBet($input: DiceBetInput!) { placeDiceBet(input: $input) { roundId betAmount targetNumber rollMode rolledNumber multiplier winAmount isWin profit } }';
        var vars = {
            input: {
                betAmount: String(amount),
                cryptoCurrency: 'USDC',
                nonce: generateUUID(),
                rollMode: 'Under',
                targetNumber: target
            }
        };
        try {
            var res = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Origin': 'https://dicey.com' },
                credentials: 'include',
                body: JSON.stringify({ operationName: 'PlaceDiceBet', query: query, variables: vars })
            });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            var data = await res.json();
            if (data.errors) throw new Error(data.errors[0].message);
            return { success: true, data: data.data.placeDiceBet };
        } catch(e) {
            return { success: false, error: e.message };
        }
    }

    var wagerLoopRunning = false;

    async function doWager() {
        if (!wagerState.isRunning || wagerState.isPaused || wagerLoopRunning) return;
        wagerLoopRunning = true;

        try {
            var bal = getRealBalance();
            if (bal !== null && bal > 0) wagerState.currentBalance = bal;

            if (wagerState.currentBalance <= 0) {
                wagerLog('❌ Insufficient balance!', '#f87171');
                stopWagerBot();
                wagerLoopRunning = false;
                return;
            }

            var l1Bet = 0.01;
            var l1Chance = 98;
            var l2Bet = 0.01;

            if (wagerState.totalBets === 0) {
                wagerState.startBalance = wagerState.currentBalance;
            }

            wagerState.totalBets++;
            var amount = wagerState.currentLayer === 1 ? l1Bet : l2Bet;
            var chance = wagerState.currentLayer === 1 ? l1Chance : Math.floor(Math.random() * 25) + 50;

            var result = await placeBet(amount, chance);
            if (!result.success) {
                wagerLog('❌ ' + result.error, '#f87171');
                wagerLoopRunning = false;
                if (wagerState.isRunning) setTimeout(doWager, 3000);
                return;
            }

            var d = result.data;
            var profit = parseFloat(d.profit) || 0;
            wagerState.currentBalance += profit;

            if (d.isWin) {
                wagerState.totalWins++;
                wagerState.currentStreak = wagerState.currentStreak > 0 ? wagerState.currentStreak + 1 : 1;
                if (wagerState.currentLayer === 2) {
                    wagerState.currentLayer = 1;
                    wagerLog('⬆️ Back to L1', '#00e5c0');
                }
            } else {
                wagerState.totalLosses++;
                wagerState.currentStreak = wagerState.currentStreak < 0 ? wagerState.currentStreak - 1 : -1;
                if (wagerState.currentLayer === 1) {
                    wagerState.currentLayer = 2;
                    wagerLog('⬇️ Switch to L2', '#ff922b');
                }
            }

            wagerLog('#' + wagerState.totalBets + ' | ' + amount.toFixed(4) + ' USDC | ' + chance + '% | ' + (d.isWin ? '✅ WIN' : '❌ LOSS'), d.isWin ? '#4ade80' : '#f87171');
            updateWagerUI();

            if (wagerState.totalBets >= 100) {
                wagerLog('🎯 Target 100 bets reached!', '#00e5c0');
                stopWagerBot();
                wagerLoopRunning = false;
                return;
            }

            var stopLoss = wagerState.startBalance * 0.1;
            if (wagerState.currentBalance <= stopLoss) {
                wagerLog('🛑 STOP LOSS reached!', '#ff6b6b');
                stopWagerBot();
                wagerLoopRunning = false;
                return;
            }

        } catch(e) {
            wagerLog('⚠️ ' + e.message, '#f87171');
        }

        wagerLoopRunning = false;
        if (wagerState.isRunning && !wagerState.isPaused) {
            setTimeout(doWager, 1500);
        }
    }

    function startWagerBot() {
        if (!isWhitelisted) { wagerLog('⚠️ Whitelist required!', '#f87171'); return; }
        if (wagerState.isRunning && !wagerState.isPaused) { wagerLog('⚠️ Already running', '#ffd700'); return; }
        if (wagerState.isPaused) {
            wagerState.isPaused = false;
            wagerState.isRunning = true;
            wagerLog('▶️ Resumed', '#00e5c0');
            updateWagerUI();
            setTimeout(doWager, 500);
            updateMasterUI();
            return;
        }

        var bal = getRealBalance();
        if (bal === null || bal <= 0) {
            wagerLog('❌ Cannot get balance!', '#f87171');
            return;
        }

        wagerState.isRunning = true;
        wagerState.isPaused = false;
        wagerState.totalBets = 0;
        wagerState.totalWins = 0;
        wagerState.totalLosses = 0;
        wagerState.currentStreak = 0;
        wagerState.currentLayer = 1;
        wagerState.currentBalance = bal;
        wagerState.startBalance = bal;
        wagerState.isLooping = false;

        wagerLog('▶️ WAGER STARTED | Balance: ' + bal.toFixed(2) + ' USDC', '#00e5c0');
        updateWagerUI();
        setTimeout(doWager, 500);
        updateMasterUI();
    }

    function pauseWagerBot() {
        if (!wagerState.isRunning) { wagerLog('⚠️ Not running', '#ffd700'); return; }
        wagerState.isPaused = !wagerState.isPaused;
        wagerLog(wagerState.isPaused ? '⏸ Paused' : '▶️ Resumed', '#ffd700');
        updateWagerUI();
        if (!wagerState.isPaused) setTimeout(doWager, 500);
        updateMasterUI();
    }

    function stopWagerBot() {
        wagerState.isRunning = false;
        wagerState.isPaused = false;
        wagerState.isLooping = false;
        var profit = wagerState.currentBalance - wagerState.startBalance;
        wagerLog('⏹ STOPPED | ' + (profit >= 0 ? '+' : '') + profit.toFixed(2) + ' USDC', '#ffd700');
        updateWagerUI();
        updateMasterUI();
    }

    function resetWagerBot() {
        stopWagerBot();
        wagerState.totalBets = 0;
        wagerState.totalWins = 0;
        wagerState.totalLosses = 0;
        wagerState.currentStreak = 0;
        wagerState.currentLayer = 1;
        var bal = getRealBalance();
        if (bal !== null && bal > 0) {
            wagerState.currentBalance = bal;
            wagerState.startBalance = bal;
        }
        wagerLog('🔄 RESET', '#ffd700');
        updateWagerUI();
        updateMasterUI();
    }

    // ============================================================
    // EVENT LISTENERS
    // ============================================================
    var usernameInput = $('dicey-username');
    var checkWhitelistBtn = $('dicey-check-whitelist');

    if (usernameInput) {
        usernameInput.oninput = updateWhitelistStatus;
        usernameInput.onkeydown = function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                updateWhitelistStatus();
            }
        };
        var savedUsername = localStorage.getItem('dicey_username');
        if (savedUsername) {
            usernameInput.value = savedUsername;
            setTimeout(updateWhitelistStatus, 500);
        }
    }

    if (checkWhitelistBtn) checkWhitelistBtn.onclick = function(e) {
        e.preventDefault();
        updateWhitelistStatus();
    };

    document.getElementById('toggle-rain').onchange = updateToggleVisibility;
    document.getElementById('toggle-wager').onchange = updateToggleVisibility;
    document.getElementById('toggle-bonus').onchange = updateToggleVisibility;

    document.getElementById('dicey-master').onclick = toggleMaster;
    document.getElementById('dicey-rain-toggle').onclick = toggleRain;
    document.getElementById('dicey-wager-toggle').onclick = toggleWager;
    document.getElementById('dicey-wager-pause').onclick = pauseWagerBot;
    document.getElementById('dicey-wager-reset').onclick = resetWagerBot;
    document.getElementById('dicey-bonus-toggle').onclick = toggleBonus;
    document.getElementById('dicey-bonus-claim').onclick = manualClaim;

    document.getElementById('dicey-clear-logs').onclick = function() {
        var logEl = $('dicey-log');
        if (logEl) logEl.innerHTML = '';
        var rainLogEl = $('dicey-rain-log');
        if (rainLogEl) rainLogEl.innerHTML = '';
    };

    var minimized = false;
    var minimizeBtn = $('dicey-minimize');
    var closeBtn = $('dicey-close');
    var content = $('dicey-content');

    if (minimizeBtn) {
        minimizeBtn.onclick = function() {
            minimized = !minimized;
            if (content) content.style.display = minimized ? 'none' : 'block';
            this.textContent = minimized ? '▲' : '▼';
            container.style.height = minimized ? '56px' : '100%';
        };
    }

    if (closeBtn) {
        closeBtn.onclick = function() {
            if (wagerState.isRunning) stopWagerBot();
            if (rainIsRunning) stopRain();
            if (bonusState.isRunning) stopBonusAuto();
            container.style.display = 'none';
        };
    }

    document.onkeydown = function(e) {
        if (e.ctrlKey && e.shiftKey && e.key === 'D') {
            e.preventDefault();
            container.style.display = container.style.display === 'none' ? 'block' : 'none';
        }
        if (e.ctrlKey && e.key === 'Enter') {
            e.preventDefault();
            toggleMaster();
        }
    };

    // ============================================================
    // INIT
    // ============================================================
    var initialBalance = getRealBalance();
    if (initialBalance !== null && initialBalance > 0) {
        wagerState.currentBalance = initialBalance;
        wagerState.startBalance = initialBalance;
    } else {
        wagerState.currentBalance = 3;
        wagerState.startBalance = 3;
    }

    setTimeout(updateToggleVisibility, 100);
    setTimeout(updateWhitelistStatus, 200);
    updateWagerUI();
    updateRainUI();
    updateBonusUI();
    updateMasterUI();

    log('🔥 DiceY Dual Engine v6.0 - Chat Detection FIXED', '#ff6b35');
    log('📱 Full screen mobile UI', '#4ade80');
    log('📌 Enter username, click CHECK, then START ALL', '#60a5fa');

    console.log('✅ Chat detection improved!');
    console.log('✅ Will scan and click Chat tab automatically');

})();
