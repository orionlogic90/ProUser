function $(id) { return document.getElementById(id); }

function log(msg, color) {
    color = color || '#888';
    var el = $('main-log');
    if (!el) return;
    var t = new Date().toLocaleTimeString();
    el.innerHTML += '<div style="color:' + color + ';padding:1px 0;font-size:8px;">[' + t + '] ' + msg + '</div>';
    el.scrollTop = el.scrollHeight;
    if (el.children.length > 100) el.removeChild(el.firstChild);
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

function genUUID() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
        var r = Math.random() * 16 | 0;
        var v = c === 'x' ? r : (r & 0x3 | 0x8);
        return v.toString(16);
    });
}

function getRealBalance() {
    try {
        // Cari balance di UI Dicey
        var selectors = [
            '[class*="balance"]', '[class*="Balance"]',
            '[data-testid="balance"]', '.balance-amount',
            '.user-balance', '.wallet-balance',
            '[class*="wallet"] [class*="amount"]',
            'header [class*="amount"]'
        ];
        for (var i = 0; i < selectors.length; i++) {
            var elements = document.querySelectorAll(selectors[i]);
            for (var j = 0; j < elements.length; j++) {
                var text = elements[j].textContent.trim();
                var match = text.match(/(\d+\.?\d*)/);
                if (match) {
                    var num = parseFloat(match[1]);
                    if (num > 0) return num;
                }
            }
        }
        return null;
    } catch(e) { return null; }
}

function forceClick(btn) {
    if (!btn) return false;
    try {
        btn.click();
        btn.dispatchEvent(new MouseEvent('click', {bubbles:true}));
        btn.dispatchEvent(new PointerEvent('pointerdown', {bubbles:true}));
        btn.dispatchEvent(new PointerEvent('pointerup', {bubbles:true}));
        return true;
    } catch(e) { return false; }
}

