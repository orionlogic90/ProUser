    var WHITELIST_URL = 'https://raw.githubusercontent.com/orionlogic90/ProUser/refs/heads/main/whitelist.json';
    var whitelistCache = null;
    var cacheExpiry = 0;

    async function fetchWhitelist() {
        if (whitelistCache && Date.now() < cacheExpiry) return whitelistCache;
        try {
            var response = await fetch(WHITELIST_URL);
            if (!response.ok) throw new Error('HTTP ' + response.status);
            var data = await response.json();
            whitelistCache = data;
            cacheExpiry = Date.now() + 300000;
            try { localStorage.setItem('dicey_whitelist', JSON.stringify(data)); } catch(e) {}
            return data;
        } catch (error) {
            try {
                var cached = localStorage.getItem('dicey_whitelist');
                if (cached) {
                    whitelistCache = JSON.parse(cached);
                    return whitelistCache;
                }
            } catch(e) {}
            return { users: { 'dengkodice': '2026-12-31', 'crotcrit666': '2026-08-10', 'admin': 'permanent', 'cheapcheatx': 'permanent' } };
        }
    }

    async function checkWhitelist(username) {
        var data = await fetchWhitelist();
        var users = data.users || {};
        username = username.toLowerCase().trim();
        if (!username) return { valid: false, reason: 'Enter username' };
        if (!users[username]) return { valid: false, reason: 'User not in whitelist' };
        var expiry = users[username];
        if (expiry === 'permanent') return { valid: true, username: username, remaining: '∞' };
        var expiryDate = new Date(expiry);
        if (new Date() > expiryDate) return { valid: false, reason: 'License expired (' + expiry + ')' };
        var remaining = Math.ceil((expiryDate - new Date()) / (1000 * 60 * 60 * 24));
        return { valid: true, username: username, remaining: remaining + ' days' };
    }

